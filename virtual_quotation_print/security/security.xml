<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_virtual_quotation_user" model="res.groups">
        <field name="name">Virtual Quotation User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('modern_quotation_catalogue.group_modern_quotation_user'))]"/>
    </record>

    <record id="group_virtual_quotation_manager" model="res.groups">
        <field name="name">Virtual Quotation Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('virtual_quotation_print.group_virtual_quotation_user')), (4, ref('modern_quotation_catalogue.group_modern_quotation_manager'))]"/>
    </record>

    <record id="rule_virtual_quotation_user" model="ir.rule">
        <field name="name">Virtual quotations: users see own or unassigned</field>
        <field name="model_id" ref="model_virtual_quotation"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('virtual_quotation_print.group_virtual_quotation_user'))]"/>
    </record>

    <record id="rule_virtual_quotation_manager" model="ir.rule">
        <field name="name">Virtual quotations: managers see all</field>
        <field name="model_id" ref="model_virtual_quotation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('virtual_quotation_print.group_virtual_quotation_manager'))]"/>
    </record>

    <record id="rule_virtual_quotation_line_user" model="ir.rule">
        <field name="name">Virtual quotation lines: users see own document lines</field>
        <field name="model_id" ref="model_virtual_quotation_line"/>
        <field name="domain_force">['|', ('quotation_id.user_id', '=', user.id), ('quotation_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('virtual_quotation_print.group_virtual_quotation_user'))]"/>
    </record>

    <record id="rule_virtual_quotation_line_manager" model="ir.rule">
        <field name="name">Virtual quotation lines: managers see all</field>
        <field name="model_id" ref="model_virtual_quotation_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('virtual_quotation_print.group_virtual_quotation_manager'))]"/>
    </record>
</odoo>
