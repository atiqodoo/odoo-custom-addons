<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_virtual_quotation_import_sale_wizard_form" model="ir.ui.view">
        <field name="name">virtual.quotation.import.sale.wizard.form</field>
        <field name="model">virtual.quotation.import.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Load Real Quotation Lines">
                <group>
                    <field name="sale_order_id"
                           context="{'search_default_quotation': 1}"
                           options="{'no_create': True}"/>
                    <field name="target_quotation_id"
                           options="{'no_create': True}"
                           placeholder="Leave empty to create a new virtual quote"/>
                    <field name="replace_lines"/>
                    <field name="result_mode"/>
                </group>
                <footer>
                    <button name="action_load_lines" type="object" string="Load Lines" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
