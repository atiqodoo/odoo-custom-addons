<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_virtual_quotation_button" model="ir.ui.view">
        <field name="name">sale.order.form.virtual.quotation.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_virtual_quotations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o">
                    <field name="virtual_quotation_count" widget="statinfo" string="Virtual Quotes"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_virtual_quotation_from_sale"
                        type="object"
                        string="Create Virtual Print Quote"
                        icon="fa-file-text-o"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent', 'sale', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
