<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_mpesa_user" model="res.groups">
            <field name="name">M-Pesa User</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="comment">Can view transactions and raw SMS logs.</field>
        </record>

        <record id="group_mpesa_manual_entry" model="res.groups">
            <field name="name">M-Pesa Manual Entry</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_mpesa_user'))]"/>
            <field name="comment">
                Can create audited manual M-Pesa transactions when SMS/network/parse failures occur.
            </field>
        </record>

        <record id="group_mpesa_manager" model="res.groups">
            <field name="name">M-Pesa Manager</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_mpesa_user')), (4, ref('group_mpesa_manual_entry'))]"/>
            <field name="comment">
                Can cancel transactions, reset stuck records, and access configuration.
            </field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mpesa_manager'))]"/>
        </record>

    </data>

    <data>
        <record id="group_mpesa_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mpesa_manual_entry'))]"/>
        </record>
    </data>
</odoo>
