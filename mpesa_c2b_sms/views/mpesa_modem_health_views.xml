<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mpesa_modem_health_list" model="ir.ui.view">
        <field name="name">mpesa.modem.health.list</field>
        <field name="model">mpesa.modem.health</field>
        <field name="arch" type="xml">
            <list string="Modem Health" decoration-danger="status=='critical'"
                  decoration-warning="status=='warning'">
                <field name="timestamp"/>
                <field name="storage_used"/>
                <field name="storage_total"/>
                <field name="usage_pct" string="Usage %"/>
                <field name="status" widget="badge"
                       decoration-success="status=='ok'"
                       decoration-warning="status=='warning'"
                       decoration-danger="status=='critical'"/>
                <field name="modem_connected" widget="boolean"/>
                <field name="last_sms_received"/>
                <field name="queue_pending"/>
                <field name="queue_failed"/>
            </list>
        </field>
    </record>

    <record id="action_mpesa_modem_health" model="ir.actions.act_window">
        <field name="name">Modem Health</field>
        <field name="res_model">mpesa.modem.health</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
