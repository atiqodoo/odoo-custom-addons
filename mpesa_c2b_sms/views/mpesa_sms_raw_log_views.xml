<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mpesa_sms_raw_log_list" model="ir.ui.view">
        <field name="name">mpesa.sms.raw.log.list</field>
        <field name="model">mpesa.sms.raw.log</field>
        <field name="arch" type="xml">
            <list string="SMS Raw Log" decoration-danger="parse_status=='failed'"
                  decoration-success="parse_status=='success'">
                <field name="received_at"/>
                <field name="queue_id"/>
                <field name="source_phone"/>
                <field name="parse_status" widget="badge"
                       decoration-success="parse_status=='success'"
                       decoration-danger="parse_status=='failed'"
                       decoration-muted="parse_status=='pending'"/>
                <field name="transaction_id"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_sms_raw_log_form" model="ir.ui.view">
        <field name="name">mpesa.sms.raw.log.form</field>
        <field name="model">mpesa.sms.raw.log</field>
        <field name="arch" type="xml">
            <form string="SMS Raw Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="queue_id"/>
                            <field name="received_at"/>
                            <field name="source_phone"/>
                            <field name="modem_index"/>
                            <field name="parse_status"/>
                            <field name="transaction_id"/>
                        </group>
                        <group>
                            <field name="raw_text" widget="text" colspan="2"/>
                            <field name="parse_error" widget="text" colspan="2"
                                   invisible="parse_status != 'failed'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mpesa_sms_raw_log" model="ir.actions.act_window">
        <field name="name">SMS Raw Log</field>
        <field name="res_model">mpesa.sms.raw.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
