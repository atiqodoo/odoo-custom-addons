<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sbl_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook>
                <page name="sbl_pos_access_rights" string="POS Access Rights">
                    <group name="sbl_pos_order_management" string="Order Management">
                        <group>
                            <field name="sbl_hide_pos_new_order_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_delete_order_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_actions_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_product_info" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_finance_from_product_info" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_hide_pos_customer_selection_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_create_customer_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_edit_customer_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_payment" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="sbl_pos_payment_screen" string="Payment Screen">
                        <group>
                            <field name="sbl_hide_pos_payment_customer_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_payment_invoice_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_payment_ship_later_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_tip_button" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_open_cashbox_button" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_hide_pos_payment_validate_button" widget="boolean_toggle"/>
                            <field name="sbl_disabled_payment_method_ids" widget="many2many_tags"/>
                            <field name="sbl_deposit_settle_payment_method_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group name="sbl_pos_actions_popup" string="Actions Popup">
                        <group>
                            <field name="sbl_hide_pos_action_general_note" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_customer_note" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_pricelist" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_hide_pos_action_refund" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_reward" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_fiscal_position" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_action_cancel_order" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="sbl_pos_numpad" string="Numpad">
                        <group>
                            <field name="sbl_hide_pos_numpad" widget="boolean_toggle"/>
                            <field name="sbl_disable_pos_change_price" widget="boolean_toggle"/>
                            <field name="sbl_disable_pos_qty" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_disable_pos_numpad_plus_minus" widget="boolean_toggle"/>
                            <field name="sbl_disable_pos_discount_button" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_global_discount" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="sbl_pos_cod" string="COD">
                        <group>
                            <field name="sbl_require_auth_cod_dispatch" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_cod_pay_all" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_cod_pay_partial" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_require_auth_cod_return_all" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_cod_return_partial" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_cod_discount" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="sbl_pos_team_kubwa" string="Team Kubwa">
                        <group>
                            <field name="sbl_require_auth_team_kubwa_open" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_create_customer" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_check_eligibility" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_save_draft" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_open_draft" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_require_auth_team_kubwa_continue_otp" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_mark_otp" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_continue_pay" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_manager_override" widget="boolean_toggle"/>
                            <field name="sbl_require_auth_team_kubwa_pay_post" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="sbl_pos_navigation_menu" string="Navigation Menu">
                        <group>
                            <field name="sbl_hide_pos_install_app" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_orders_menu" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_backend_menu" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_cash_in_out" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sbl_hide_pos_close_register" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_daily_sale" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_clear_cache" widget="boolean_toggle"/>
                            <field name="sbl_hide_pos_debug_window" widget="boolean_toggle"/>
                            <field name="sbl_block_mpesa_sms_app" widget="boolean_toggle"/>
                        </group>
                    </group>
                </page>

                <!-- ── App Gate tab ─────────────────────────────────────── -->
                <page name="sbl_app_gate" string="App Gate">
                    <group string="Blocked Apps">
                        <field name="sbl_blocked_app_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               string="Blocked Apps"
                               help="Apps this employee is BLOCKED from. All gated apps always require a PIN — but if an app appears here, this employee will be denied access even with a valid PIN."/>
                    </group>
                    <group string="How It Works">
                        <div colspan="2" class="text-muted">
                            <p>
                                <strong>All apps</strong> listed in
                                <strong>Settings → Technical → App Gate Configuration</strong>
                                always prompt for an Employee PIN when clicked —
                                regardless of who is logged into Odoo.
                            </p>
                            <p>
                                The employee identifies themselves by entering their
                                <strong>PIN</strong> (set on the Settings tab → HR Settings → PIN).
                                If the app is in their <strong>Blocked Apps</strong> list above,
                                they will see: <em>"Employee [Name] is not authorized to access [App]"</em>
                                even if their PIN is correct.
                            </p>
                            <p>
                                All attempts (successful and failed) are recorded in
                                <strong>Settings → Technical → App Gate Access Log</strong>.
                            </p>
                        </div>
                    </group>
                </page>

            </notebook>
        </field>
    </record>
</odoo>

