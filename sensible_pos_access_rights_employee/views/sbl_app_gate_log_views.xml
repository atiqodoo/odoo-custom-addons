<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ───────────────────────────────────────────────────────── -->
    <record id="sbl_app_gate_log_tree" model="ir.ui.view">
        <field name="name">sbl.app.gate.log.tree</field>
        <field name="model">sbl.app.gate.log</field>
        <field name="arch" type="xml">
            <list string="App Gate Access Log" create="false" edit="false" delete="false"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'">
                <field name="create_date" string="Date / Time"/>
                <field name="app_name" string="App"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="status"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       widget="badge"/>
                <field name="failure_reason"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ───────────────────────────────────────────────────────── -->
    <record id="sbl_app_gate_log_form" model="ir.ui.view">
        <field name="name">sbl.app.gate.log.form</field>
        <field name="model">sbl.app.gate.log</field>
        <field name="arch" type="xml">
            <form string="App Gate Log Entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="App">
                            <field name="app_name"/>
                            <field name="app_xmlid"/>
                        </group>
                        <group string="Outcome">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'failed'"/>
                            <field name="failure_reason"
                                   invisible="status == 'success'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Who">
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="When">
                            <field name="create_date" string="Date / Time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ─────────────────────────────────────────────────────── -->
    <record id="sbl_app_gate_log_search" model="ir.ui.view">
        <field name="name">sbl.app.gate.log.search</field>
        <field name="model">sbl.app.gate.log</field>
        <field name="arch" type="xml">
            <search string="App Gate Logs">
                <field name="app_name" string="App"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <filter name="filter_success" string="Successful" domain="[('status','=','success')]"/>
                <filter name="filter_failed"  string="Failed"     domain="[('status','=','failed')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('create_date','&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_app"      string="App"      context="{'group_by': 'app_name'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_status"   string="Status"   context="{'group_by': 'status'}"/>
                    <filter name="group_date"     string="Date"     context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Pivot view ──────────────────────────────────────────────────────── -->
    <record id="sbl_app_gate_log_pivot" model="ir.ui.view">
        <field name="name">sbl.app.gate.log.pivot</field>
        <field name="model">sbl.app.gate.log</field>
        <field name="arch" type="xml">
            <pivot string="App Gate Log">
                <field name="app_name"    type="row"/>
                <field name="status"      type="col"/>
                <field name="employee_id" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- ── Window action ───────────────────────────────────────────────────── -->
    <record id="sbl_app_gate_log_action" model="ir.actions.act_window">
        <field name="name">App Gate Access Log</field>
        <field name="res_model">sbl.app.gate.log</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No access attempts recorded yet.
            </p>
            <p>
                Every time an employee enters (or fails to enter) their PIN
                to open an app, the attempt is logged here.
            </p>
        </field>
    </record>

    <!-- ── Settings > Technical menu item ─────────────────────────────────── -->
    <menuitem
        id="sbl_app_gate_log_menu"
        name="App Gate Access Log"
        parent="base.menu_custom"
        action="sbl_app_gate_log_action"
        sequence="151"
        groups="base.group_system"/>

</odoo>
