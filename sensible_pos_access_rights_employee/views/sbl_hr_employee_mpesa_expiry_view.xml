<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sbl_hr_employee_form_mpesa_expiry_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.mpesa.expiry.authorization.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="sensible_pos_access_rights_employee.sbl_hr_employee_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sbl_pos_payment_screen']/group[2]" position="inside">
                <field name="sbl_allow_expired_mpesa_sms_override"
                       widget="boolean_toggle"
                       string="Allow Expired M-Pesa SMS Override"/>
                <field name="sbl_allow_mpesa_sms_freeze"
                       widget="boolean_toggle"
                       string="Allow M-Pesa SMS Freeze"/>
                <field name="sbl_allow_mpesa_sms_unfreeze"
                       widget="boolean_toggle"
                       string="Allow M-Pesa SMS Unfreeze"/>
            </xpath>
        </field>
    </record>
</odoo>
