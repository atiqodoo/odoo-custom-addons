<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="barcode_label_config_bixolon_27mm" model="barcode.label.config">
        <field name="name">Bixolon 27mm 2-Up</field>
        <field name="is_default">1</field>
        <field name="printer_name">BIXOLON SLP-DX420 - BPL-Z</field>
        <field name="print_width">448</field>
        <field name="label_length">216</field>
        <field name="left_x">8</field>
        <field name="right_x">232</field>
        <field name="panel_width">204</field>
        <field name="barcode_module_width">1</field>
        <field name="auto_fit_barcode">1</field>
        <field name="printer_language">zpl</field>
        <field name="barcode_type">code39</field>
        <field name="barcode_height">58</field>
        <field name="barcode_y">86</field>
        <field name="darkness">30</field>
        <field name="print_speed">2</field>
    </record>

    <record id="view_barcode_label_config_list" model="ir.ui.view">
        <field name="name">barcode.label.config.list</field>
        <field name="model">barcode.label.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="printer_name"/>
                <field name="print_width"/>
                <field name="label_length"/>
                <field name="barcode_module_width"/>
                <field name="auto_fit_barcode"/>
                <field name="printer_language"/>
                <field name="barcode_type"/>
                <field name="barcode_height"/>
                <field name="darkness"/>
                <field name="print_speed"/>
            </list>
        </field>
    </record>

    <record id="view_barcode_label_config_form" model="ir.ui.view">
        <field name="name">barcode.label.config.form</field>
        <field name="model">barcode.label.config</field>
        <field name="arch" type="xml">
            <form string="Barcode Label Configuration">
                <header>
                    <button name="action_set_default"
                            type="object"
                            string="Set Default"
                            class="btn-primary"/>
                    <button name="action_test_print"
                            type="object"
                            string="Test Print"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="is_default"/>
                            <field name="printer_name"/>
                            <field name="label_title"/>
                        </group>
                        <group string="Media">
                            <field name="print_width"/>
                            <field name="label_length"/>
                            <field name="left_x"/>
                            <field name="right_x"/>
                            <field name="panel_width"/>
                        </group>
                    </group>
                    <group>
                        <group string="Text Position">
                            <field name="title_y"/>
                            <field name="line_1_y"/>
                            <field name="line_2_y"/>
                            <field name="title_font_height"/>
                            <field name="title_font_width"/>
                            <field name="text_font_height"/>
                            <field name="text_font_width"/>
                            <field name="title_max_chars"/>
                            <field name="text_line_chars"/>
                            <field name="text_max_lines"/>
                        </group>
                        <group string="Barcode / Printer">
                            <field name="barcode_y"/>
                            <field name="barcode_height"/>
                            <field name="barcode_module_width"/>
                            <field name="auto_fit_barcode"/>
                            <field name="printer_language"/>
                            <field name="barcode_type"/>
                            <field name="barcode_wide_ratio"/>
                            <field name="center_barcode"/>
                            <field name="darkness"/>
                            <field name="print_speed"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_barcode_label_config" model="ir.actions.act_window">
        <field name="name">Label Configurations</field>
        <field name="res_model">barcode.label.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_barcode_label_config"
              name="Label Configurations"
              parent="menu_barcode_label_print_root"
              action="action_barcode_label_config"
              sequence="20"
              groups="stock.group_stock_user"/>

</odoo>
