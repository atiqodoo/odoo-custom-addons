<?xml version="1.0" encoding="utf-8"?>
<!--
    stock_receipt_label_wizard_views.xml
    =====================================
    Form view for stock.receipt.label.wizard (the label print popup dialog).

    Layout overview:

        Receipt: WH/IN/00277
        Print: [Both]  Format: [ZPL]  Lot Qty: [One per lot]

        [ ] Product                   Lot/SN    Received  Labels
        [x] 1LTR GAMMA GLOSS (white)             20.00    [20]
        [x] 1LTR GAMMA GLOSS (black)             20.00    [20]
        [x] 2.5KG CROWN DU CO         LOT-001     5.00    [5]

        [Select All]  [Deselect All]    [Skip]  [Print Labels]

    Notes:
    - The list is editable so operators can adjust label_qty inline.
    - decoration-muted on deselected lines gives clear visual feedback.
    - lot_id column is hidden when scope is product-only.
    - lot_qty_mode is hidden when no lots are present.
    - Select All / Deselect All do a server round-trip to re-check all rows.
-->
<odoo>

    <!-- Window action (referenced programmatically by stock_picking.py) -->
    <record id="action_stock_receipt_label_wizard" model="ir.actions.act_window">
        <field name="name">Print Receipt Labels</field>
        <field name="res_model">stock.receipt.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard form view -->
    <record id="view_stock_receipt_label_wizard_form" model="ir.ui.view">
        <field name="name">stock.receipt.label.wizard.form</field>
        <field name="model">stock.receipt.label.wizard</field>
        <field name="arch" type="xml">

            <form string="Print Receipt Labels">
                <sheet>

                    <!-- Header: receipt name banner -->
                    <div class="alert alert-info mb-3" role="status"
                         invisible="not picking_names">
                        <i class="fa fa-print me-2"/>
                        <strong>Receipt: </strong>
                        <field name="picking_names" readonly="1" nolabel="1"
                               class="d-inline"/>
                    </div>

                    <!-- Configuration row: scope / format / lot qty mode -->
                    <group col="3" name="config_row">

                        <field name="label_scope"
                               string="Print"
                               widget="radio"
                               options="{'horizontal': true}"/>

                        <field name="label_format"
                               string="Format"/>

                        <field name="lot_qty_mode"
                               string="Lot Label Qty"
                               invisible="label_scope == 'products' or not has_lots"/>

                    </group>

                    <!-- Hidden computed helpers used by the view -->
                    <field name="has_lots" invisible="1"/>
                    <field name="line_count" invisible="1"/>

                    <!-- Lines list -->
                    <field name="wizard_line_ids"
                           nolabel="1"
                           string="Products to label">
                        <list editable="bottom"
                              decoration-muted="not selected"
                              no_open="1"
                              limit="200">

                            <field name="selected"
                                   string="Print"
                                   widget="boolean_toggle"
                                   optional="show"/>

                            <field name="product_id"
                                   readonly="1"
                                   string="Product"
                                   options="{'no_open': True}"/>

                            <field name="lot_id"
                                   readonly="1"
                                   string="Lot / SN"
                                   optional="show"
                                   column_invisible="parent.label_scope == 'products'"/>

                            <field name="product_barcode"
                                   readonly="1"
                                   string="Barcode"
                                   optional="show"/>

                            <field name="qty_received"
                                   readonly="1"
                                   string="Received"
                                   optional="show"/>

                            <field name="uom_name"
                                   readonly="1"
                                   string="Unit"
                                   optional="hide"/>

                            <field name="label_qty"
                                   string="Labels"
                                   optional="show"/>

                        </list>
                    </field>

                    <!-- Summary below the list -->
                    <div class="text-muted small mt-1">
                        <field name="line_count" readonly="1" nolabel="1"
                               class="d-inline"/>
                        <span> product line(s). Uncheck rows to skip, edit
                               the Labels column to change how many print.
                        </span>
                    </div>

                </sheet>

                <!-- Footer buttons -->
                <footer>

                    <button name="action_print"
                            type="object"
                            string="Print Labels"
                            class="btn-primary"
                            data-hotkey="v"/>

                    <button name="action_select_all"
                            type="object"
                            string="Select All"
                            class="btn-secondary"/>

                    <button name="action_deselect_all"
                            type="object"
                            string="Deselect All"
                            class="btn-secondary"/>

                    <button name="action_skip"
                            type="object"
                            string="Skip"
                            class="btn-secondary"
                            data-hotkey="z"/>

                </footer>
            </form>

        </field>
    </record>

</odoo>
