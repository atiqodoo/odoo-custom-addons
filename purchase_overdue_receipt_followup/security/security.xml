<odoo>
    <record id="vendor_delivery_policy_company_rule" model="ir.rule">
        <field name="name">Vendor delivery policy company</field>
        <field name="model_id" ref="model_purchase_vendor_delivery_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="delivery_reschedule_company_rule" model="ir.rule">
