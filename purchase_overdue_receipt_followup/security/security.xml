        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="receipt_followup_company_rule" model="ir.rule">
        <field name="name">Receipt follow-up company</field>
        <field name="model_id" ref="model_purchase_receipt_followup"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="receipt_replacement_company_rule" model="ir.rule">
        <field name="name">Receipt replacement company</field>
        <field name="model_id" ref="model_purchase_receipt_replacement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
