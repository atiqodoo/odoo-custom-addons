<odoo>
    <record id="receipt_followup_list" model="ir.ui.view">
        <field name="name">purchase.receipt.followup.list</field>
        <field name="model">purchase.receipt.followup</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="state == 'open'" decoration-muted="state == 'resolved'">
                <field name="product_id"/><field name="company_id" groups="base.group_multi_company"/>
                <field name="location_id"/><field name="first_expected_date"/><field name="overdue_qty"/>
                <field name="uom_id"/><field name="reliable_forecast_qty"/><field name="suggested_qty"/>
                <field name="state"/><field name="replacement_order_id"/>
                <button name="action_review" type="object" string="Review" icon="fa-warning" invisible="state != 'open'"/>
                <button name="action_compare_stock" type="object" string="Compare Stock" icon="fa-exchange"/>
            </list>
        </field>
    </record>
    <record id="receipt_followup_form" model="ir.ui.view">
        <field name="name">purchase.receipt.followup.form</field>
        <field name="model">purchase.receipt.followup</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_review" type="object" string="Review / Request Replacement" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_compare_stock" type="object" string="Compare Similar Stock"/>
                    <button name="action_open_receipts" type="object" string="Open Receipts"/>
                    <button name="action_open_purchase_orders" type="object" string="Open POs"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="product_id"/><field name="orderpoint_id"/><field name="company_id"/>
                            <field name="location_id"/><field name="first_expected_date"/><field name="uom_id"/></group>
                        <group><field name="overdue_qty"/><field name="forecast_qty"/><field name="reliable_forecast_qty"/>
                            <field name="suggested_qty"/><field name="replacement_order_id"/>
                            <field name="replacement_user_id"/><field name="replacement_date"/></group>
                    </group>
                    <field name="replacement_reason"/>
                    <field name="move_ids">
                        <list create="0" edit="0" delete="0">
                            <field name="picking_id"/><field name="purchase_line_id"/><field name="product_id"/>
                            <field name="date"/><field name="product_uom_qty"/><field name="product_uom"/><field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="receipt_followup_search" model="ir.ui.view">
        <field name="name">purchase.receipt.followup.search</field>
        <field name="model">purchase.receipt.followup</field>
        <field name="arch" type="xml">
            <search>
            <field name="product_id"/><field name="replacement_order_id"/>
            <filter name="needs_followup" string="Needs Follow-up" domain="[('state', '=', 'open')]"/>
            <filter name="replacement_requested" string="Replacement Requested" domain="[('state', '=', 'replaced')]"/>
            </search>
        </field>
    </record>
    <record id="receipt_followup_action" model="ir.actions.act_window">
        <field name="name">Overdue Receipt Follow-ups</field>
        <field name="res_model">purchase.receipt.followup</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_followup': 1}</field>
    </record>
    <menuitem id="receipt_followup_menu" name="Overdue Receipt Follow-ups"
              parent="purchase.menu_procurement_management" action="receipt_followup_action"
              groups="purchase.group_purchase_user" sequence="30"/>
</odoo>
