<odoo>
    <record id="purchase_settings_receipt_followup" model="ir.ui.view">
        <field name="name">purchase.settings.receipt.followup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Overdue Receipt Follow-up" name="overdue_receipt_followup">
                    <setting string="Delivery lead-time day" company_dependent="1"
                             help="Convert lead-time days to this many working hours. Closed periods are skipped using the receiving calendar.">
                        <field name="delivery_hours_per_day"/><span> working hours per day</span>
                        <div class="content-group"><label for="delivery_planning_horizon_days"/>
                            <field name="delivery_planning_horizon_days"/>
                        </div>
                    </setting>
                    <setting string="Warn about overdue supplier receipts" company_dependent="1"
                             help="Monitor automatic Buy reordering rules, without changing Odoo forecasts or cancelling original receipts.">
                        <field name="receipt_followup_enabled"/>
                        <div class="content-group">
                            <label for="receipt_followup_calendar_id"/><field name="receipt_followup_calendar_id" required="receipt_followup_enabled"/>
                            <div invisible="not receipt_followup_enabled">
                                <label for="receipt_followup_grace_hours"/><field name="receipt_followup_grace_hours"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
