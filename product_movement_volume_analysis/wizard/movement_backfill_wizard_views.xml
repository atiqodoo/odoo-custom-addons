<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_movement_volume_backfill_wizard" model="ir.ui.view">
        <field name="name">product.movement.volume.backfill.wizard.form</field>
        <field name="model">product.movement.volume.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Backfill Movement Volume">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="max_records"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Only missing facts are generated. Existing facts are never changed or duplicated.
                </div>
                <footer>
                    <button name="action_backfill" string="Run Backfill" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_movement_volume_backfill" model="ir.actions.act_window">
        <field name="name">Backfill Movement Volume</field>
        <field name="res_model">product.movement.volume.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

