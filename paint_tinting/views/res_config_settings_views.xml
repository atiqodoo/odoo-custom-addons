<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tint_formula_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tint.formula.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Tinting Formula Control" name="tinting_formula_control_settings">
                    <setting id="auto_approve_first_tint_formula"
                             string="Automatically Approve First Tinting Formula"
                             help="Approve and make default only Version 1 of a previously unregistered tinting formula family. Later versions still require Tinting Formula Manager approval.">
                        <field name="auto_approve_first_tint_formula"/>
                        <div class="text-muted">
                            APS remains an intentional auto-approval exception. Enabling this setting does not retroactively approve existing Draft or Validated versions.
                        </div>
                    </setting>
                    <setting id="block_cost_comparison_use_this"
                             string="Block Cost Comparison Use This"
                             help="Prevent users from switching the base product by clicking Use This inside the cost comparison wizard.">
                        <field name="block_cost_comparison_use_this"/>
                        <div class="text-muted">
                            On by default. Turn this off to allow the existing Use This workflow in the cost comparison wizard.
                        </div>
                    </setting>
                    <setting id="tinted_product_category_policy"
                             string="Tinted Product Category"
                             help="Choose where dynamically created tinted products are placed.">
                        <field name="tinted_product_category_policy"/>
                        <field name="tinted_product_child_category_name"
                               invisible="tinted_product_category_policy != 'child_base'"/>
                        <div class="text-muted">
                            Child category mode creates or reuses Tinted Paint under the selected base product category and copies the parent category accounting setup.
                        </div>
                    </setting>
                    <setting id="default_vat_percent"
                             string="Tinting VAT %"
                             help="VAT percentage used when operational tinting costs need VAT-inclusive reporting.">
                        <field name="default_vat_percent"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
