<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_formula_import_wizard_form" model="ir.ui.view">
        <field name="name">tinting.formula.import.wizard.form</field>
        <field name="model">tinting.formula.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Formula Drafts">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Download the controlled XLSX template, complete one formula per row, then upload it for validation and preview. Import never approves formulas automatically.
                    </div>
                    <group>
                        <field name="upload_file" filename="upload_filename"/>
                        <field name="upload_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download_template" string="Download XLSX Template" type="object" class="btn-secondary"/>
                    <button name="action_validate_upload" string="Validate &amp; Preview" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_formula_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Formula Drafts</field>
        <field name="res_model">tinting.formula.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_formula_import_batch_list" model="ir.ui.view">
        <field name="name">tinting.formula.import.batch.list</field>
        <field name="model">tinting.formula.import.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="state" widget="badge"/>
                <field name="row_count"/>
                <field name="valid_count"/>
                <field name="duplicate_count"/>
                <field name="error_count"/>
                <field name="imported_count"/>
                <field name="uploaded_by_id"/>
                <field name="uploaded_date"/>
            </list>
        </field>
    </record>

    <record id="view_formula_import_batch_form" model="ir.ui.view">
        <field name="name">tinting.formula.import.batch.form</field>
        <field name="model">tinting.formula.import.batch</field>
        <field name="arch" type="xml">
            <form string="Formula Import Preview" create="0" edit="0">
                <header>
                    <button name="action_create_drafts" string="Create Valid Drafts" type="object"
                            class="oe_highlight" invisible="state != 'preview' or valid_count == 0"/>
                    <button name="action_cancel" string="Cancel Batch" type="object"
                            invisible="state != 'preview'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="filename"/>
                            <field name="source_attachment_id"/>
                            <field name="uploaded_by_id"/>
                            <field name="uploaded_date"/>
                        </group>
                        <group string="Preview Counts">
                            <field name="row_count"/>
                            <field name="valid_count"/>
                            <field name="duplicate_count"/>
                            <field name="error_count"/>
                            <field name="imported_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Spreadsheet Rows">
                            <field name="row_ids">
                                <list decoration-success="state == 'valid' or state == 'imported'"
                                      decoration-muted="state == 'duplicate'"
                                      decoration-danger="state == 'error'">
                                    <field name="row_number"/>
                                    <field name="external_reference"/>
                                    <field name="colour_code"/>
                                    <field name="base_category_name"/>
                                    <field name="base_uom_name"/>
                                    <field name="base_attribute_name"/>
                                    <field name="recipe_display"/>
                                    <field name="state" widget="badge"/>
                                    <field name="planned_action"/>
                                    <field name="message"/>
                                    <field name="formula_id" optional="hide"/>
                                    <field name="version_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit Summary">
                            <field name="log_summary" nolabel="1"/>
                            <field name="imported_version_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="change_summary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_formula_import_batches" model="ir.actions.act_window">
        <field name="name">Formula Import Batches</field>
        <field name="res_model">tinting.formula.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_formula_bulk_approve_wizard_form" model="ir.ui.view">
        <field name="name">tinting.formula.bulk.approve.wizard.form</field>
        <field name="model">tinting.formula.bulk.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Retroactively Approve Formula Versions">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Retroactive approval makes the selected Draft or Validated recipes immutable and available in the tinting wizard. Review the versions and default policy carefully.
                    </div>
                    <group>
                        <field name="version_count" readonly="1"/>
                        <field name="default_policy" widget="radio"/>
                        <field name="confirmation_note"/>
                    </group>
                    <field name="version_ids">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="state" widget="badge"/>
                            <field name="origin"/>
                            <field name="change_summary"/>
                            <field name="total_shots"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Approval" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
