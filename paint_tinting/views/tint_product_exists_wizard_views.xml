<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tint_product_exists_wizard_form" model="ir.ui.view">
        <field name="name">tint.product.exists.wizard.form</field>
        <field name="model">tint.product.exists.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Already Exists">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>This tinted product already exists.</strong>
                        <p class="mb-0 mt-1">
                            A tinted product with this colour and base has already been created.
                            Open the existing Manufacturing Order to duplicate production instead.
                        </p>
                    </div>

                    <!-- Show which SO triggered this, if applicable -->
                    <div class="alert alert-info" role="alert"
                         invisible="not source_sale_order_id">
                        <strong>From Sales Order: <field name="source_so_name" readonly="1" class="oe_inline"/></strong>
                        <span class="ms-2 text-muted">
                            After duplicating the MO, you will be returned to this order automatically.
                        </span>
                    </div>

                    <group string="Existing Product">
                        <field name="product_name" readonly="1"/>
                        <field name="product_tmpl_id" readonly="1" options="{'no_open': False}"/>
                    </group>

                    <group string="Latest Manufacturing Order" invisible="not mo_id">
                        <field name="mo_name" readonly="1" string="Reference"/>
                        <field name="mo_state" readonly="1" string="Status"/>
                        <field name="mo_qty" readonly="1" string="Quantity" digits="[16, 4]"/>
                    </group>

                    <div class="alert alert-info" invisible="mo_id" role="alert">
                        No Manufacturing Order found for this product.
                    </div>

                    <!-- Hidden SO field needed for button visibility -->
                    <field name="source_sale_order_id" invisible="1"/>

                    <div class="o_row mt-3">
                        <button name="action_open_mo"
                                string="Open MO to Duplicate"
                                type="object"
                                class="btn btn-primary"
                                invisible="not mo_id"
                                title="Opens MO — use Duplicate MO button there. Returns to SO automatically after."/>
                        <button name="action_open_all_mos"
                                string="View All MOs"
                                type="object"
                                class="btn btn-secondary ms-2"
                                invisible="not product_tmpl_id"/>
                        <button name="action_return_to_so"
                                string="Return to SO"
                                type="object"
                                class="btn btn-secondary ms-2"
                                invisible="not source_sale_order_id"
                                title="Go back to the originating Sales Order"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
