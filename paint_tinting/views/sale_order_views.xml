<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit main sale order form view - Smart Button -->
    <record id="view_order_form_inherit_tinting_smart_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tinting.smart.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tint_mos"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="tint_mo_count == 0">
                    <field name="tint_mo_count" widget="statinfo" string="Tinting MOs"/>
                </button>
            </xpath>

            <!-- Position the smart button inside the header -->
            <xpath expr="//header" position="inside">

                <field name="has_tinted_stock_shortage" invisible="1"/>
                <field name="tinted_stock_shortage_product_count" invisible="1"/>

                <button name="action_create_tinted_product_from_line"
                        string="Create Tinted Product &amp; MO"
                        type="object"
                        class="oe_highlight"
                        groups="sales_team.group_sale_salesman"
                        invisible="not has_pending_tinted_lines"
                        title="Process the next unprocessed tinted product line"/>

                <button name="action_produce_next_missing_tinted_qty"
                        string="Produce Missing Tinted Qty"
                        type="object"
                        class="btn-warning"
                        groups="sales_team.group_sale_salesman"
                        invisible="not has_tinted_stock_shortage"
                        title="Open production for the first tinted product whose live warehouse stock is below the quoted quantity"/>

            </xpath>

        </field>
    </record>

    <!-- Optional: Small info banner below title (visible only when condition met) -->
    <record id="view_order_form_inherit_tinting_status" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tinting.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/div[@class='oe_title']" position="after">

                <div class="alert alert-info oe_inline" role="alert"
                     invisible="not has_pending_tinted_lines">
                    <strong><field name="pending_tinted_line_count" readonly="1" nolabel="1"/> tinted product(s) pending manufacture.</strong>
                    Click <strong>"Create Tinted Product &amp; MO"</strong> on each line below, or use the header button to process the next one.
                </div>

            </xpath>

        </field>
    </record>


    <!-- Keep all sales order line drag/drop behavior on Odoo's sequence field. -->
    <record id="view_order_form_inherit_tinting_order_line_sequence_order" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tinting.order.line.sequence.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="default_order">sequence,id</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="order">sequence ASC, id ASC</attribute>
            </xpath>
        </field>
    </record>


    <!-- Per-line "Create Tinted Product & MO" button + done indicator -->
    <record id="view_order_form_inherit_tinting_line_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tinting.line.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <!-- Load flags as invisible columns so they can drive visibility conditions -->
                <field name="is_tinted_product_line" column_invisible="1"/>
                <field name="tinted_product_created" column_invisible="1"/>
                <field name="tint_mo_count" column_invisible="1"/>
                <field name="tint_revision_count"
                       string="Tint Edits"
                       readonly="1"
                       optional="hide"/>
                <field name="tinted_stock_available_qty"
                       string="Tinted Available"
                       readonly="1"
                       optional="show"/>
                <field name="tinted_stock_shortage_qty"
                       string="Tinted Missing"
                       readonly="1"
                       optional="show"
                       decoration-danger="tinted_stock_shortage_qty &gt; 0"
                       decoration-success="tinted_product_created and tinted_stock_shortage_qty &lt;= 0"/>

                <!-- Per-line create button — visible only on unprocessed tinted lines -->
                <button name="action_create_tinted_product_for_line"
                        string="Create Tinted &amp; MO"
                        type="object"
                        class="btn-primary btn-sm"
                        invisible="not is_tinted_product_line or tinted_product_created"
                        title="Create tinted product, BOM and manufacturing order for this line"/>

                <button name="action_edit_tint_colourants"
                        string="Edit Tint / Colourants"
                        type="object"
                        class="btn-secondary btn-sm"
                        invisible="not is_tinted_product_line or tinted_product_created"
                        title="Edit colourant shots before creating the tinted product and manufacturing order"/>

                <button name="action_view_tint_revisions"
                        string="Tint History"
                        type="object"
                        class="btn-secondary btn-sm"
                        invisible="not is_tinted_product_line or tint_revision_count == 0"
                        title="Open the audit history for tint changes on this line"/>

                <!-- Done badge — visible only on already-processed tinted lines -->
                <button string="✓ MO Created"
                        type="object"
                        name="action_create_tinted_product_for_line"
                        class="btn-success btn-sm"
                        invisible="not is_tinted_product_line or not tinted_product_created"
                        disabled="1"
                        title="Tinted product and MO already created for this line"/>

                <button name="action_view_tint_mos"
                        string="View MO"
                        type="object"
                        class="btn-secondary btn-sm"
                        invisible="not is_tinted_product_line or tint_mo_count == 0"
                        title="Open manufacturing order(s) linked to this sale order line"/>

                <button name="action_produce_missing_tinted_qty"
                        string="Produce Missing Qty"
                        type="object"
                        class="btn-warning btn-sm"
                        invisible="not is_tinted_product_line or not tinted_product_created or tinted_stock_shortage_qty &lt;= 0"
                        title="Duplicate and complete enough one-unit tinting MOs to cover the live warehouse shortage"/>
            </xpath>

        </field>
    </record>

</odoo>
