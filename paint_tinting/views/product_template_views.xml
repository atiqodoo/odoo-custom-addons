<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View - Add Tinting Fields -->
    <record id="view_product_template_form_tinting" model="ir.ui.view">
        <field name="name">product.template.form.tinting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Tinting notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Tinting" name="tinting" 
                      invisible="not is_tinted_product and not is_colorant">
                    <group>
                        <group string="Product Type">
                            <field name="is_tinted_product"/>
                            <field name="is_colorant"/>
                            <field name="paint_type" 
                                   invisible="not is_tinted_product"/>
                        </group>
                        
                        <group string="Colorant Information" 
                               invisible="not is_colorant">
                            <field name="colorant_code"/>
                        </group>
                    </group>
                    
                    <group invisible="not is_tinted_product">
                        <group string="Colour Information">
                            <field name="fandeck_id" readonly="1"/>
                            <field name="colour_code_id" readonly="1"/>
                            <field name="colour_name" readonly="1"/>
                        </group>
                        
                        <group string="Cost Information">
                            <field name="cost_price_excl_vat" readonly="1"/>
                            <field name="cost_price_incl_vat" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product List View - Add Tinting Filters -->
    <record id="view_product_template_list_tinting" model="ir.ui.view">
        <field name="name">product.template.list.tinting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">is_tinted_product</attribute>
                <attribute name="decoration-success">is_colorant</attribute>
            </xpath>
        </field>
    </record>

    <!-- Product Search View - Add Tinting Filters -->
    <record id="view_product_template_search_tinting" model="ir.ui.view">
        <field name="name">product.template.search.tinting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Tinted Products" name="tinted_products"
                        domain="[('is_tinted_product', '=', True)]"/>
                <filter string="Colorants" name="colorants"
                        domain="[('is_colorant', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Paint Type" name="group_paint_type"
                            context="{'group_by': 'paint_type'}"/>
                    <filter string="Fandeck" name="group_fandeck"
                            context="{'group_by': 'fandeck_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_list_tinted_mistakes" model="ir.ui.view">
        <field name="name">product.product.list.tinted.mistakes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">has_tinted_mistake_mapping</attribute>
            </xpath>
            <field name="name" position="after">
                <field name="has_tinted_mistake_mapping" optional="hide"/>
                <field name="tinted_mistake_mapping_count" optional="show"/>
                <field name="tinted_mistake_open_count" optional="hide"/>
                <field name="tinted_mistake_state" optional="show"/>
                <field name="tinted_mistake_mismatch_type" optional="show"/>
                <field name="tinted_mistake_stock_decision" optional="hide"/>
                <field name="tinted_mistake_financial_decision" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_product_product_kanban_tinted_mistakes" model="ir.ui.view">
        <field name="name">product.product.kanban.tinted.mistakes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates" position="before">
                <field name="has_tinted_mistake_mapping"/>
                <field name="tinted_mistake_mapping_count"/>
                <field name="tinted_mistake_state"/>
                <field name="tinted_mistake_mismatch_type"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']/main" position="inside">
                <div t-if="record.has_tinted_mistake_mapping.raw_value" class="mt-1">
                    <span class="badge rounded-pill text-bg-warning">
                        Mistake <field name="tinted_mistake_state"/>
                    </span>
                    <span class="badge rounded-pill text-bg-light ms-1">
                        <field name="tinted_mistake_mapping_count"/> mapped
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_search_tinted_mistakes" model="ir.ui.view">
        <field name="name">product.product.search.tinted.mistakes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Mistaken Tint Mapped"
                        name="tinted_mistake_mapped"
                        domain="[('has_tinted_mistake_mapping', '=', True)]"/>
                <filter string="Draft Mistake Mapping"
                        name="tinted_mistake_draft"
                        domain="[('tinted_mistake_state', '=', 'draft')]"/>
                <filter string="Open Mistake Mapping"
                        name="tinted_mistake_open"
                        domain="[('tinted_mistake_state', 'in', ('draft', 'under_review', 'confirmed', 'quarantined', 'resolved'))]"/>
                <filter string="Wrong UoM Mistake"
                        name="tinted_mistake_wrong_uom"
                        domain="[('tinted_mistake_mismatch_type', '=', 'wrong_uom')]"/>
                <filter string="Wrong Base/Category Mistake"
                        name="tinted_mistake_wrong_base_category"
                        domain="[('tinted_mistake_mismatch_type', 'in', ('wrong_base', 'wrong_category'))]"/>
                <separator/>
                <group expand="0" string="Mistake Group By">
                    <filter string="Mistake Status"
                            name="group_tinted_mistake_state"
                            context="{'group_by': 'tinted_mistake_state'}"/>
                    <filter string="Mismatch Type"
                            name="group_tinted_mistake_mismatch_type"
                            context="{'group_by': 'tinted_mistake_mismatch_type'}"/>
                    <filter string="Stock Decision"
                            name="group_tinted_mistake_stock_decision"
                            context="{'group_by': 'tinted_mistake_stock_decision'}"/>
                    <filter string="Financial Decision"
                            name="group_tinted_mistake_financial_decision"
                            context="{'group_by': 'tinted_mistake_financial_decision'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Tinted Products Action -->
    <record id="action_tinted_products" model="ir.actions.act_window">
        <field name="name">Tinted Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_tinted_product', '=', True)]</field>
        <field name="context">{'search_default_tinted_products': 1}</field>
    </record>

    <!-- Colorants Action -->
    <record id="action_colorants" model="ir.actions.act_window">
        <field name="name">Colorants</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_colorant', '=', True)]</field>
        <field name="context">{'search_default_colorants': 1}</field>
    </record>
</odoo>
