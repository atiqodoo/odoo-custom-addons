<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tint_formula_search_form" model="ir.ui.view">
        <field name="name">tint.formula.search.wizard.form</field>
        <field name="model">tint.formula.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Search Approved Formula Versions">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Search by formula/version name. APS formulas show their attached customer.
                    </div>
                    <field name="tint_wizard_id" invisible="1"/>
                    <field name="available_formula_version_ids" invisible="1"/>
                    <group>
                        <field name="formula_version_id"
                               options="{'no_create': True, 'no_open': False}"
                               placeholder="Search approved formula versions..."/>
                        <field name="formula_id"/>
                        <field name="state" widget="badge"/>
                        <field name="is_aps" widget="boolean_toggle"/>
                        <field name="aps_customer_id" invisible="not is_aps"/>
                    </group>
                    <group string="Version Changes">
                        <field name="change_summary" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_formula" string="Apply Formula"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
