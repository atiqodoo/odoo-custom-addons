<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_tint_edit_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.line.tint.edit.wizard.form</field>
        <field name="model">sale.order.line.tint.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Tint / Colourants">
                <header>
                    <button name="action_apply_changes"
                            string="Apply Changes"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <group string="Sale Line">
                        <group>
                            <field name="sale_order_line_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="colour_code_id" readonly="1"/>
                            <field name="fandeck_id" readonly="1"/>
                            <field name="base_category_id" readonly="1"/>
                            <field name="base_product_id" readonly="1"/>
                            <field name="base_product_uom_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Before / After Cost Snapshot">
                        <group>
                            <field name="before_base_cost_incl_vat" readonly="1"/>
                            <field name="before_colorant_cost_incl_vat" readonly="1"/>
                            <field name="before_total_cost_incl_vat" readonly="1"/>
                            <field name="before_price_unit" readonly="1"/>
                        </group>
                        <group>
                            <field name="after_colorant_cost_incl_vat" readonly="1"/>
                            <field name="after_total_cost_incl_vat" readonly="1"/>
                            <field name="cost_delta_incl_vat" readonly="1"/>
                            <field name="profit_after_incl_vat" readonly="1"/>
                        </group>
                    </group>

                    <group string="Quick Add Shots">
                        <field name="new_colorant_id" options="{'no_create': True}"/>
                        <field name="new_colorant_shots"/>
                        <button name="action_add_colorant"
                                string="Add Shots to Colourant"
                                type="object"
                                class="btn-secondary"/>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="colorant_id" options="{'no_create': True}"/>
                            <field name="colorant_code" readonly="1"/>
                            <field name="shots"/>
                            <field name="shots_to_add"/>
                            <field name="shots_history" readonly="1" optional="show"/>
                            <field name="shots_history_total" column_invisible="1"/>
                            <field name="qty_litres" readonly="1"/>
                            <field name="unit_cost_excl_vat" readonly="1"/>
                            <field name="line_cost_incl_vat" readonly="1"/>
                        </list>
                    </field>

                    <group string="Reason">
                        <field name="change_reason"
                               placeholder="Why are the shots being changed?"/>
                    </group>
                    <field name="before_formula_json" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
