<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_profit_tab" model="ir.ui.view">
        <field name="name">sale.order.form.profit.tab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Order Profit" name="so_order_profit_tab">

                    <group string="Profit Summary" name="so_profit_summary_group">
                        <group>
                            <field name="so_grand_total_profit"
                                   widget="monetary"
                                   decoration-success="so_grand_total_profit &gt; 0"
                                   decoration-danger="so_grand_total_profit &lt; 0"/>
                        </group>
                    </group>

                    <separator string="Order Lines - Profit Breakdown (Cost incl. VAT vs Selling Price)"/>

                    <field name="order_line" nolabel="1" mode="tree,form">
                        <form>
                            <group>
                                <group>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit" string="Selling Price"/>
                                </group>
                                <group>
                                    <field name="so_profit_cost_incl_vat" widget="monetary"/>
                                    <field name="so_profit_per_unit" widget="monetary"/>
                                    <field name="so_profit_total" widget="monetary"/>
                                </group>
                            </group>
                        </form>
                        <list create="false" delete="false">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="price_unit" readonly="1" widget="monetary" string="Selling Price"/>
                            <field name="so_profit_cost_incl_vat" readonly="1" widget="monetary"/>
                            <field name="so_profit_per_unit"
                                   readonly="1"
                                   widget="monetary"
                                   decoration-success="so_profit_per_unit &gt; 0"
                                   decoration-danger="so_profit_per_unit &lt; 0"/>
                            <field name="so_profit_total"
                                   readonly="1"
                                   widget="monetary"
                                   decoration-success="so_profit_total &gt; 0"
                                   decoration-danger="so_profit_total &lt; 0"/>
                        </list>
                    </field>

                    <div class="alert alert-info" role="alert" style="margin-top: 15px;">
                        <p><strong>Profit Calculation (Cost incl. VAT vs Selling Price):</strong></p>
                        <ul>
                            <li>Cost Price (incl. VAT) = Standard Cost × (1 + VAT Rate%)</li>
                            <li>Profit / Unit = Selling Price − Cost Price (incl. VAT)</li>
                            <li>Total Profit = Profit / Unit × Quantity</li>
                            <li>Standard cost sourced from product AVCO/Standard Price</li>
                        </ul>
                    </div>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
