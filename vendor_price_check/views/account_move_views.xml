<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_line_promised_cost_diff_list" model="ir.ui.view">
        <field name="name">account.move.line.promised.cost.diff.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Promised Cost Differences"
                  create="false"
                  edit="false"
                  decoration-danger="promised_cost_difference_vat_incl &gt; 0"
                  decoration-success="promised_cost_difference_vat_incl &lt; 0">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price_vat_incl" widget="monetary"/>
                <field name="vendor_promised_cost_vat_incl" widget="monetary"/>
                <field name="promised_cost_difference_vat_incl"
                       widget="monetary"
                       decoration-danger="promised_cost_difference_vat_incl &gt; 0"
                       decoration-success="promised_cost_difference_vat_incl &lt; 0"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- 1. Your Existing Buttons (Unchanged)          -->
    <!-- ============================================= -->
    <record id="view_move_form_inherit_vendor_price_check" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vendor.price.check</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="bill_grade_volume_summary"
                       readonly="1"
                       widget="text"
                       invisible="not bill_grade_volume_summary"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <field name="discrepancy_count" readonly="1" invisible="1"/>
                <field name="discrepancy_approved" readonly="1" invisible="1"/>
                <field name="promised_cost_diff_count" readonly="1" invisible="1"/>
                <field name="invoice_variance_audit_count" readonly="1" invisible="1"/>
                <button name="action_view_discrepancies"
                        type="object"
                        string="View Discrepancies"
                        invisible="discrepancy_count == 0"/>
                <button name="action_view_promised_cost_diffs"
                        type="object"
                        string="View Promised Cost Diff"
                        invisible="promised_cost_diff_count == 0"/>
                <button name="action_view_invoice_variance_audits"
                        type="object"
                        string="Invoice Variance Audits"
                        invisible="invoice_variance_audit_count == 0"/>
                <button name="action_approve_discrepancy"
                        type="object"
                        string="Approve Discrepancies"
                        invisible="discrepancy_count == 0 or discrepancy_approved"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- 2. NEW: Add column to invoice lines           -->
    <!-- ============================================= -->
    <record id="view_move_form_inherit_line_subtotal_incl_vat" model="ir.ui.view">
        <field name="name">account.move.form.inherit.line.subtotal.incl.vat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="vpc_from_vendor_price_wizard" column_invisible="1"/>
                <field name="bill_volume_reference_uom_id" column_invisible="1"/>
                <field name="unit_price_vat_incl"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"
                       readonly="1"/>
                <field name="wizard_vendor_list_unit_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"
                       readonly="1"/>
                <field name="wizard_vendor_line_total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_discount_percentage" optional="hide" readonly="1"/>
                <field name="wizard_freight_percentage" optional="hide" readonly="1"/>
                <field name="wizard_tint_type" optional="hide" readonly="1"/>
                <field name="wizard_tint_percentage" optional="hide" readonly="1"/>
                <field name="wizard_computed_unit_excl_vat"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_unit_vat_incl"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"
                       readonly="1"/>
                <field name="wizard_computed_line_total_vat_incl"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_gross_total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_discount_amount"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_tint_charge"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_subtotal_excl_vat"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="wizard_computed_promised_cost_diff_vat_incl"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"
                       readonly="1"/>
                <field name="bill_volume_reporting_grade_id" optional="show" readonly="1"/>
                <field name="bill_grade_volume_label" optional="show" readonly="1"/>
                <field name="bill_grade_amount_vat_incl"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"
                       readonly="1"
                       sum="Grade Value VAT Incl."/>
                <field name="line_subtotal_incl_vat"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total Incl. VAT"/>
            </xpath>
        </field>
    </record>

    <!-- Optional: Show in Bill List View -->
    <record id="view_move_tree_inherit_line_subtotal" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.line.subtotal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <list>
                <field name="amount_total" string="Total"/>
            </list>
        </field>
    </record>

</odoo>
