<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_crown_invoice_audit" model="ir.ui.view">
        <field name="name">account.move.form.crown.invoice.audit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="vendor_invoice_unit_price" optional="hide" readonly="1"/>
                <field name="vendor_invoice_line_total" optional="hide" readonly="1"/>
                <field name="vendor_structured_discount_percentage" optional="hide" readonly="1"/>
                <field name="vendor_invoice_variance_allocated" optional="hide" readonly="1"/>
                <field name="vendor_final_unit_price_vat_incl" optional="hide" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Vendor Invoice Calculation"
                      name="vendor_invoice_calculation"
                      invisible="vendor_invoice_profile != 'crown_paints'">
                    <group>
                        <group>
                            <field name="vendor_invoice_profile" readonly="1"/>
                            <field name="vendor_calculated_total_vat_incl" readonly="1"/>
                            <field name="vendor_invoice_final_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="vendor_invoice_variance_amount" readonly="1"/>
                            <field name="vendor_invoice_variance_percentage" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
