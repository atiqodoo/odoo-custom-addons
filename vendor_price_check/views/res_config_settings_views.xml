<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_vendor_price" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vendor.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="inside">
                <setting id="vendor_price_check_bill_count"
                         help="Configure how vendor bill prices are validated against historical data">
                    <field name="price_check_bill_count" class="oe_inline"/>
                    <div class="text-muted mt8">
                        Number of previous vendor bills to check for product price comparison
                    </div>
                </setting>
                <setting id="vendor_price_check_approver"
                         help="User who must approve bills when price discrepancies are detected">
                    <field name="price_check_approver_id"
                           domain="[('share', '=', False)]"
                           placeholder="Select a user..."/>
                    <div class="text-muted mt8">
                        This user can approve promised-cost and price discrepancies
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
