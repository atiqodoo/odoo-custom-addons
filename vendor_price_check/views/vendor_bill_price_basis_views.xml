<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_price_wizard_price_basis" model="ir.ui.view">
        <field name="name">vendor.price.wizard.price.basis</field>
        <field name="model">vendor.price.wizard</field>
        <field name="inherit_id" ref="vendor_price_check.view_vendor_price_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Vendor Price Entry">
                    <field name="supports_vendor_price_basis" invisible="1"/>
                    <field name="vendor_price_basis" widget="radio" options="{'horizontal': true}"
                           invisible="not supports_vendor_price_basis"/>
                    <div invisible="supports_vendor_price_basis">Price basis is controlled by the configured vendor formula.</div>
                    <div invisible="not supports_vendor_price_basis" class="text-muted">
                        Select the basis of the vendor unit/list prices before discount and freight.
                        For prices already adjusted, enter zero discount and freight.
                        The final invoice total always includes VAT.
                    </div>
                </group>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="string">PO Unit Price (Excl. VAT)</attribute>
            </xpath>
            <xpath expr="//field[@name='calculated_subtotal']" position="attributes">
                <attribute name="string">Calculated Unit (Excl. VAT)</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_vendor_price_basis_audit" model="ir.ui.view">
        <field name="name">account.move.form.vendor.price.basis.audit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="vendor_price_check.view_move_form_inherit_line_subtotal_incl_vat"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='wizard_vendor_list_unit_price']" position="after">
                <field name="wizard_vendor_price_basis" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
