<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_auto_variant_price" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.auto.variant.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Auto Variant Price Increase" id="pos_auto_variant_price_settings">
                    <setting string="Auto Increase Selling Prices"
                             help="Increase product variant selling prices when inclusive cost rises.">
                        <field name="auto_variant_price_enabled"/>
                    </setting>
                    <setting string="Rounding Formula"
                             help="The cost increase is rounded upward to the configured step, then added to the current selling price.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="auto_variant_price_rounding_step" string="Rounding Step" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_rounding_step"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_include_vat" string="Include VAT" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_include_vat"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_vat_rate" string="VAT Rate (%)" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_vat_rate"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Triggers"
                             help="Choose which cost events may update selling prices.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="auto_variant_price_on_receipt" string="Incoming Receipts" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_on_receipt"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_on_landed_cost" string="Landed Costs" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_on_landed_cost"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_on_vendor_bill" string="Vendor Bills" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_on_vendor_bill"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_on_manual_cost" string="Manual Cost Changes" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_on_manual_cost"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_update_pricelist" string="Update POS Pricelist" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_update_pricelist"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_pricelist_scope" string="Pricelist Scope" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_pricelist_scope"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_variant_price_log_no_change" string="Log No-Change Checks" class="col-lg-4 o_light_label"/>
                                <field name="auto_variant_price_log_no_change"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
