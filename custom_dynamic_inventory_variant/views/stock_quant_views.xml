<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_dynamic_variant" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.dynamic.variant</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="dynamic_product_tmpl_id"
                       string="Template"
                       readonly="id"
                       optional="show"
                       domain="[('is_storable', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="dynamic_attribute_value_ids"
                       string="Variant Values"
                       widget="many2many_tags"
                       readonly="id"
                       optional="show"
                       domain="[('product_tmpl_id', '=', dynamic_product_tmpl_id)]"
                       options="{'no_create': True}"/>
                <button name="action_generate_dynamic_variant"
                        type="object"
                        string="Resolve"
                        class="btn btn-link"
                        icon="fa-cogs"
                        invisible="not dynamic_product_tmpl_id or product_id"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="required">not dynamic_product_tmpl_id</attribute>
                <attribute name="readonly">context.get('single_product', False) or id or dynamic_product_tmpl_id</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="dynamic_variant_debug_message" optional="hidden" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_form_dynamic_variant" model="ir.ui.view">
        <field name="name">stock.quant.form.dynamic.variant</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="before">
                <field name="dynamic_product_tmpl_id"
                       string="Template"
                       readonly="context.get('readonly_form')"
                       domain="[('is_storable', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="dynamic_attribute_value_ids"
                       string="Variant Values"
                       widget="many2many_tags"
                       readonly="context.get('readonly_form')"
                       domain="[('product_tmpl_id', '=', dynamic_product_tmpl_id)]"
                       options="{'no_create': True}"/>
                <button name="action_generate_dynamic_variant"
                        type="object"
                        string="Generate Variant"
                        class="btn btn-secondary"
                        icon="fa-cogs"
                        invisible="not dynamic_product_tmpl_id or product_id or context.get('readonly_form')"/>
                <field name="dynamic_variant_debug_message" readonly="1" invisible="not dynamic_variant_debug_message"/>
            </xpath>
        </field>
    </record>
</odoo>
