<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_local_documents_importer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.local.documents.importer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="documents.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='files_centralization_section']" position="inside">
                <setting id="local_documents_importer" string="Local Folder Imports" help="Map Windows scanner/download folders into Odoo Documents folders.">
                    <a type="action" name="%(local_document_watch_path_action)d" class="btn btn-primary">
                        Configure Imports
                    </a>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
