<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Sale Order Creation" id="sbl_pos_create_sale_order">
                    <setting id="digest" string="Create Draft Sale Orders">
                        <field name="sbl_create_sale_order"/>
                        <div class="content-group" invisible="not sbl_create_sale_order">
                            <div class="mt16">
                                <label for="sbl_create_sale_order_action" class="o_light_label mr8"/>
                                <field name="sbl_create_sale_order_action" required="sbl_create_sale_order" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
