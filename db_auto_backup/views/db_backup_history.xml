<odoo>
    <record id="view_db_backup_history_tree" model="ir.ui.view">
        <field name="name">db.backup.history.tree</field>
        <field name="model">db.backup.history</field>
        <field name="arch" type="xml">
            <list string="Database Backup History"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="backup_config_id"/>
                <field name="backup_date"/>
                <field name="run_type"/>
                <field name="backup_format"/>
                <field name="status"/>
                <field name="integrity_status"/>
                <field name="expected_filestore_files" optional="hide"/>
                <field name="backup_filestore_files" optional="hide"/>
                <field name="missing_filestore_files"/>
                <field name="missing_filestore_sample" optional="hide"/>
                <field name="file_size"/>
                <field name="error_message" optional="hide"/>
                <field name="backup_path"/>
                <field name="offsite_backup_path"/>
                <button name="action_check_backup_integrity" icon="fa-check-square-o" type="object"
                        class="btn-secondary" groups="base.group_system"
                        invisible="status != 'success' or backup_format != 'zip'"/>
                <button name="action_restore_to_test_database" icon="fa-database" type="object"
                        class="btn-secondary" groups="base.group_system"
                        invisible="status != 'success'"/>
                <button name="action_download_file" icon="fa-download" type="object"
                        class="btn-primary" groups="base.group_system"/>
                <button name="action_delete_file" icon="fa-trash" type="object"
                        class="btn-danger" groups="base.group_system"/>
            </list>
        </field>
    </record>

    <record id="action_db_backup_history" model="ir.actions.act_window">
        <field name="name">Backup History</field>
        <field name="res_model">db.backup.history</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_db_backup_history" name="Backup History"
              parent="db_backup_menu_root" action="action_db_backup_history"
              sequence="1"/>
</odoo>
