<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.electricity.submeter</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Electricity Sub-Meter Invoicing" id="electricity_submeter_section">
                    <div class="row mt16 o_settings_container" id="electricity_submeter_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="electricity_journal_setting">
                            <div class="o_setting_right_pane">
                                <label for="electricity_journal_id" string="Invoicing Journal"/>
                                <div class="text-muted">
                                    Select the sales journal used to invoice sub-meter electricity redistribution.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="electricity_journal_id" class="w-75" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="electricity_account_setting">
                            <div class="o_setting_right_pane">
                                <label for="electricity_account_id" string="Income/Offset Account"/>
                                <div class="text-muted">
                                    The revenue/expense offset account in your Chart of Accounts.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="electricity_account_id" class="w-75" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="electricity_product_setting">
                            <div class="o_setting_right_pane">
                                <label for="electricity_product_id" string="Default Service Product"/>
                                <div class="text-muted">
                                    Default Service Product used for invoicing neighbor sub-meter consumption.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="electricity_product_id" class="w-75" domain="[('type', '=', 'service')]" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
