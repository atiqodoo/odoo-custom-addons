<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_log_manager" model="ir.module.category">
        <field name="name">Log Manager</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_log_manager_user" model="res.groups">
        <field name="name">Log Manager User</field>
        <field name="category_id" ref="module_category_log_manager"/>
    </record>

    <record id="group_log_manager_admin" model="res.groups">
        <field name="name">Log Manager Administrator</field>
        <field name="category_id" ref="module_category_log_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_log_manager_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
