<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="log_manager_source_view_list" model="ir.ui.view">
        <field name="name">log.manager.source.list</field>
        <field name="model">log.manager.source</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active or not exists">
                <header>
                    <button name="action_discover_sources" type="object" string="Discover" class="btn-primary"
                            groups="odoo_log_manager_ui.group_log_manager_admin"/>
                    <button name="action_refresh_metadata" type="object" string="Refresh"
                            groups="odoo_log_manager_ui.group_log_manager_admin"/>
                    <button name="action_rotate_and_index" type="object" string="Rotate / Index"
                            groups="odoo_log_manager_ui.group_log_manager_admin"/>
                </header>
                <field name="active"/>
                <field name="name"/>
                <field name="exists"/>
                <field name="size_mb"/>
                <field name="last_modified"/>
                <field name="tail_lines"/>
                <field name="path"/>
                <button name="action_tail" type="object" string="Tail" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="log_manager_source_view_form" model="ir.ui.view">
        <field name="name">log.manager.source.form</field>
        <field name="model">log.manager.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_tail" type="object" string="Tail" class="btn-primary"/>
                    <button name="action_refresh_metadata" type="object" string="Refresh"
                            groups="odoo_log_manager_ui.group_log_manager_admin"/>
                    <button name="action_rotate_and_index" type="object" string="Rotate / Index"
                            groups="odoo_log_manager_ui.group_log_manager_admin"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="path"/>
                            <field name="tail_lines"/>
                        </group>
                        <group>
                            <field name="exists"/>
                            <field name="size_bytes"/>
                            <field name="size_mb"/>
                            <field name="last_modified"/>
                            <field name="last_refresh"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="log_manager_source_action" model="ir.actions.act_window">
        <field name="name">Log Sources</field>
        <field name="res_model">log.manager.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
