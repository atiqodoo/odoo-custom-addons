<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="log_manager_entry_view_list" model="ir.ui.view">
        <field name="name">log.manager.entry.list</field>
        <field name="model">log.manager.entry</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="level in ('ERROR', 'CRITICAL')"
                  decoration-warning="level == 'WARNING'"
                  decoration-muted="level == 'DEBUG'">
                <field name="timestamp"/>
                <field name="level"/>
                <field name="database"/>
                <field name="module"/>
                <field name="message"/>
                <field name="source_type"/>
                <field name="line_no"/>
            </list>
        </field>
    </record>

    <record id="log_manager_entry_view_form" model="ir.ui.view">
        <field name="name">log.manager.entry.form</field>
        <field name="model">log.manager.entry</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="level"/>
                            <field name="database"/>
                            <field name="module"/>
                        </group>
                        <group>
                            <field name="source_type"/>
                            <field name="source_path"/>
                            <field name="line_no"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message" nolabel="1"/>
                        </page>
                        <page string="Raw">
                            <field name="raw" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="log_manager_entry_view_search" model="ir.ui.view">
        <field name="name">log.manager.entry.search</field>
        <field name="model">log.manager.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="module"/>
                <field name="database"/>
                <field name="source_path"/>
                <filter name="errors" string="Errors" domain="[('level', 'in', ('ERROR', 'CRITICAL'))]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'WARNING')]"/>
                <filter name="live" string="Live" domain="[('source_type', '=', 'live')]"/>
                <filter name="indexed" string="Indexed" domain="[('source_type', '=', 'indexed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_by_module" string="Module" context="{'group_by': 'module'}"/>
                    <filter name="group_by_database" string="Database" context="{'group_by': 'database'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="log_manager_entry_action" model="ir.actions.act_window">
        <field name="name">Log Entries</field>
        <field name="res_model">log.manager.entry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 1}</field>
    </record>
</odoo>
