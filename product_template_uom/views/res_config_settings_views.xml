<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_uom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product.template.uom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Unit of Measure Validation" id="product_uom_validation">
                    <setting string="Require Unit of Measure on products"
                             help="When enabled, products cannot be saved without an explicitly selected Unit of Measure. When disabled, the system default UoM is accepted.">
                        <field name="product_require_uom"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
