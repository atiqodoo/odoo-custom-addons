<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_session_z_report_range_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.z.report.range.wizard.form</field>
        <field name="model">pos.session.z.report.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Z-Report Summary">
                <field name="state" invisible="1"/>
                <field name="session_count" invisible="1"/>
                <group>
                    <group>
                        <field name="period_type" readonly="state == 'done'"/>
                        <field name="year" readonly="state == 'done'" invisible="period_type == 'custom'"/>
                        <field name="month" readonly="state == 'done'" invisible="period_type != 'month'"/>
                        <field name="quarter" readonly="state == 'done'" invisible="period_type != 'quarter'"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="state == 'done' or period_type != 'custom'"/>
                        <field name="date_to" readonly="state == 'done' or period_type != 'custom'"/>
                        <field name="config_ids" widget="many2many_tags" readonly="state == 'done'"/>
                        <field name="include_in_progress" readonly="state == 'done'"/>
                    </group>
                </group>

                <group invisible="state != 'done'">
                    <field name="session_count"/>
                    <field name="report_filename" invisible="1"/>
                    <field name="report_file"
                           filename="report_filename"
                           string="Download Z-Report Summary"
                           widget="binary"/>
                </group>

                <footer>
                    <button name="action_generate"
                            string="Generate Summary"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_session_z_report_range_wizard" model="ir.actions.act_window">
        <field name="name">Z-Report Summary</field>
        <field name="res_model">pos.session.z.report.range.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_session_z_report_range_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
