<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard form view ─────────────────────────────────────────── -->
    <record id="view_pos_session_z_report_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.z.report.wizard.form</field>
        <field name="model">pos.session.z.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Z-Report">
                <field name="state" invisible="1"/>
                <group>
                    <field name="session_id"
                           readonly="state == 'done'"/>
                    <field name="currency_id" invisible="1"/>
                </group>

                <!-- Download section — only visible after generation -->
                <group invisible="state != 'done'">
                    <field name="report_filename" invisible="1"/>
                    <field name="report_file"
                           filename="report_filename"
                           string="Download Z-Report"
                           widget="binary"/>
                </group>

                <footer>
                    <button name="action_generate"
                            string="Generate Z-Report"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Z-Report button on the POS session form view ────────────── -->
    <record id="view_pos_session_z_report_button" model="ir.ui.view">
        <field name="name">pos.session.z.report.button</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_z_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-excel-o"
                        string="Z-Report"/>
            </xpath>
        </field>
    </record>

</odoo>
