<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Report Action
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_pos_session_z_report_pdf" model="ir.actions.report">
        <field name="name">Z-Report PDF</field>
        <field name="model">pos.session.z.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_session_z_report.pos_session_z_report_pdf</field>
        <field name="report_file">pos_session_z_report.pos_session_z_report_pdf</field>
        <field name="print_report_name">'Z-Report_%s__%s' % (object.session_id.name.replace('/', '-'), time.strftime('%Y-%m-%d'))</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Reusable sub-section template for Receipts Detail rows
    ══════════════════════════════════════════════════════════════════ -->
    <template id="receipts_subsection">
        <div style="margin-bottom:2px; padding:3px 8px; font-weight:bold; font-size:10px;
                    background:#EAF4E9; color:#1A5E1A; border-left:3px solid #82C785;">
            <t t-esc="sub_title"/>
        </div>
        <t t-if="sub_rows">
            <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                <thead>
                    <tr style="background:#82C785; color:#fff;">
                        <th style="padding:3px 6px; text-align:left;">Payment Method</th>
                        <th style="padding:3px 6px; text-align:center;">Transactions</th>
                        <th style="padding:3px 6px; text-align:right;">Amount</th>
                        <th style="padding:3px 6px; text-align:right;"><t t-esc="sub_sym"/></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="section_total" t-value="0.0"/>
                    <t t-set="section_count" t-value="0"/>
                    <t t-foreach="sub_rows" t-as="row">
                        <tr t-attf-style="background:{{ '#F4FBF3' if row_index % 2 == 0 else '#fff' }};">
                            <td style="padding:3px 6px; font-weight:bold;"><t t-esc="row['name']"/></td>
                            <td style="padding:3px 6px; text-align:center;"><t t-esc="row['count']"/></td>
                            <td style="padding:3px 6px; text-align:right;"><t t-esc="'{:,.2f}'.format(row['amount'])"/></td>
                            <td style="padding:3px 6px; text-align:right;"><t t-esc="sub_sym"/></td>
                        </tr>
                        <t t-set="section_total" t-value="section_total + row['amount']"/>
                        <t t-set="section_count" t-value="section_count + row['count']"/>
                    </t>
                    <tr style="background:#E8F4E8; font-weight:bold; border-top:1px solid #82C785;">
                        <td style="padding:3px 6px;">TOTAL</td>
                        <td style="padding:3px 6px; text-align:center;"><t t-esc="section_count"/></td>
                        <td style="padding:3px 6px; text-align:right; color:#1A5E1A;">
                            <t t-esc="'{:,.2f}'.format(section_total)"/>
                        </td>
                        <td style="padding:3px 6px; text-align:right;"><t t-esc="sub_sym"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p style="font-style:italic; color:#888; font-size:9px; padding:2px 8px; margin:0 0 8px 0;">
                <t t-esc="sub_empty"/>
            </p>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════════════════════
         QWeb Template  (Page 1 = Z-Report, Page 2 = Receipts Detail)
    ══════════════════════════════════════════════════════════════════ -->
    <template id="pos_session_z_report_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc['wizard']"/>

                <!-- ════════════════════════════════════════════════════
                     PAGE 1 — Z-REPORT
                ════════════════════════════════════════════════════ -->
                <t t-call="web.internal_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #222;">

                        <!-- TITLE -->
                        <div style="text-align:center; background:#2E4057; color:#fff;
                                    padding:10px 0; margin-bottom:10px; border-radius:4px;">
                            <h2 style="margin:0; font-size:18px; letter-spacing:2px;">Z - REPORT</h2>
                        </div>

                        <!-- SESSION HEADER -->
                        <table style="width:100%; margin-bottom:10px; border-collapse:collapse;">
                            <tr>
                                <td style="width:15%; font-weight:bold;">Shop:</td>
                                <td style="width:35%;"><t t-esc="doc['session'].config_id.name"/></td>
                                <td style="width:15%; font-weight:bold;">Opened (EAT):</td>
                                <td style="width:35%;"><t t-esc="doc['opened_at']"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Session:</td>
                                <td><t t-esc="doc['session'].name"/></td>
                                <td style="font-weight:bold;">Closed (EAT):</td>
                                <td><t t-esc="doc['closed_at']"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Cashier:</td>
                                <td><t t-esc="doc['session'].user_id.name"/></td>
                                <td></td><td></td>
                            </tr>
                        </table>

                        <!-- SECTION 1 — SESSION CONTROL (CASH) -->
                        <div style="background:#D6E4F0; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:4px; border-left:4px solid #4A6FA5;">
                            Session Control
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                            <tr>
                                <td style="width:50%; font-weight:bold;">Total Sales:</td>
                                <td style="text-align:right; font-weight:bold;">
                                    <t t-esc="'{:,.2f}'.format(sum(doc['session'].order_ids.mapped('amount_total')))"/>
                                    <t t-esc="' ' + doc['sym']"/>
                                </td>
                                <td style="width:30%; padding-left:10px; font-weight:bold;">Transactions:</td>
                                <td style="text-align:right; font-weight:bold;">
                                    <t t-esc="len(doc['session'].order_ids)"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="doc['cash_row']">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                                <thead>
                                    <tr style="background:#4A6FA5; color:#fff;">
                                        <th style="padding:4px 6px; text-align:left;">Name</th>
                                        <th style="padding:4px 6px; text-align:right;">Expected</th>
                                        <th style="padding:4px 6px; text-align:right;">Counted</th>
                                        <th style="padding:4px 6px; text-align:right;">Difference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="font-weight:bold; background:#f5f5f5;">
                                        <td style="padding:4px 6px;"><t t-esc="doc['cash_row']['name']"/></td>
                                        <td style="padding:4px 6px; text-align:right;"><t t-esc="'{:,.2f}'.format(doc['cash_row']['expected'])"/></td>
                                        <td style="padding:4px 6px; text-align:right;"><t t-esc="'{:,.2f}'.format(doc['cash_row']['counted'])"/></td>
                                        <td t-attf-style="padding:4px 6px; text-align:right; color:{{ '#C0392B' if doc['cash_row']['difference'] &lt; 0 else '#1A7F3C' }};">
                                            <t t-esc="'{:,.2f}'.format(doc['cash_row']['difference'])"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="doc['cash_row']['sub_lines']" t-as="sl">
                                        <tr>
                                            <td style="padding:2px 6px 2px 20px; color:#555; font-style:italic;"><t t-esc="sl[0]"/></td>
                                            <td style="padding:2px 6px; text-align:right; color:#555; font-style:italic;"><t t-esc="'{:,.2f}'.format(sl[1])"/></td>
                                            <td></td><td></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc['cash_row']['float_carry_fwd'] is not None">
                                        <tr style="background:#2E4057; color:#fff; font-weight:bold;">
                                            <td style="padding:5px 8px;" colspan="2">
                                                Float Carry Forward (Next Opening)
                                            </td>
                                            <td style="padding:5px 8px; text-align:right; font-size:12px;" colspan="2">
                                                <t t-esc="'{:,.2f}'.format(doc['cash_row']['float_carry_fwd'])"/>
                                                <span style="font-size:9px; opacity:0.75;"> <t t-esc="doc['sym']"/></span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- SECTION 2 — OTHER PAYMENT METHODS -->
                        <t t-if="doc['other_rows']">
                            <div style="background:#D6E4F0; padding:5px 8px; font-weight:bold;
                                        font-size:12px; margin-bottom:4px; border-left:4px solid #4A6FA5;">
                                Other Payment Methods
                            </div>
                            <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                                <thead>
                                    <tr style="background:#4A6FA5; color:#fff;">
                                        <th style="padding:4px 6px; text-align:left;">Name</th>
                                        <th style="padding:4px 6px; text-align:right;">Amount</th>
                                        <th style="padding:4px 6px; text-align:right;"><t t-esc="doc['sym']"/></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc['other_rows']" t-as="pm">
                                        <tr t-attf-style="background:{{ '#f9f9f9' if pm_index % 2 == 0 else '#fff' }};">
                                            <td style="padding:4px 6px; font-weight:bold;"><t t-esc="pm['name']"/></td>
                                            <td style="padding:4px 6px; text-align:right; font-weight:bold;">
                                                <t t-esc="'{:,.2f}'.format(pm['amount'])"/>
                                            </td>
                                            <td style="padding:4px 6px; text-align:right;"><t t-esc="doc['sym']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- SECTION 3 — SESSION PROFIT SUMMARY -->
                        <div style="background:#D6E4F0; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:4px; border-left:4px solid #4A6FA5;">
                            Session Profit Summary
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#4A6FA5; color:#fff;">
                                    <th style="padding:4px 6px; text-align:left;">Revenue &amp; Cost</th>
                                    <th style="padding:4px 6px; text-align:right;">Amount</th>
                                    <th style="padding:4px 6px; text-align:left; padding-left:20px;">Profit</th>
                                    <th style="padding:4px 6px; text-align:right;">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background:#f5f5f5;">
                                    <td style="padding:4px 6px; font-weight:bold;">Total Selling Price</td>
                                    <td style="padding:4px 6px; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(doc['profit']['total_selling'])"/>
                                    </td>
                                    <td style="padding:4px 6px; font-weight:bold; padding-left:20px;">Total Profit</td>
                                    <td style="padding:4px 6px; text-align:right; font-weight:bold; color:#1A7F3C;">
                                        <t t-esc="'{:,.2f}'.format(doc['profit']['total_profit'])"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:4px 6px; font-weight:bold;">Total Cost (incl. VAT + Landed)</td>
                                    <td style="padding:4px 6px; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(doc['profit']['total_cost'])"/>
                                    </td>
                                    <td style="padding:4px 6px; font-weight:bold; padding-left:20px;">Profit Margin</td>
                                    <td style="padding:4px 6px; text-align:right; font-weight:bold;">
                                        <t t-esc="'{:.2f}%'.format(doc['profit']['margin_pct'])"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- SECTION 4 — SESSION ACTIVITY SUMMARY -->
                        <div style="background:#FFF2CC; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:4px; border-left:4px solid #D4A017;
                                    color:#7D4D00;">
                            Session Activity Summary
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#4A6FA5; color:#fff;">
                                    <th style="padding:4px 6px; text-align:left; width:34%;">Metric</th>
                                    <th style="padding:4px 6px; text-align:left; width:22%;">Created / Issued / Reg.</th>
                                    <th style="padding:4px 6px; text-align:right; width:14%;">Amount</th>
                                    <th style="padding:4px 6px; text-align:left; width:22%;">Used / Redeemed / Rec.</th>
                                    <th style="padding:4px 6px; text-align:right; width:8%;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc['activity']" t-as="m">
                                    <tr t-attf-style="background:{{ '#FFFDE7' if m_index % 2 == 0 else '#fff' }};">
                                        <td style="padding:4px 6px; font-weight:bold;"><t t-esc="m['label']"/></td>
                                        <td style="padding:4px 6px; color:#555; font-size:10px;">
                                            <t t-esc="m['left_label']"/>
                                            <t t-if="m['left_note']">
                                                <br/><span style="font-style:italic; color:#888;"><t t-esc="m['left_note']"/></span>
                                            </t>
                                        </td>
                                        <td style="padding:4px 6px; text-align:right; font-weight:bold;">
                                            <t t-esc="'{:,.2f}'.format(m['left_val'])"/>
                                        </td>
                                        <td style="padding:4px 6px; color:#1F497D; font-size:10px;">
                                            <t t-esc="m['right_label']"/>
                                            <t t-if="m['right_note']">
                                                <br/><span style="font-style:italic; color:#888;"><t t-esc="m['right_note']"/></span>
                                            </t>
                                        </td>
                                        <td style="padding:4px 6px; text-align:right; font-weight:bold; color:#1F497D;">
                                            <t t-esc="'{:,.2f}'.format(m['right_val'])"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Page 1 footer note -->
                        <div style="margin-top:10px; font-size:8px; color:#888; border-top:1px solid #ccc; padding-top:4px;">
                            <p style="margin:1px 0;">• Cost per unit = Standard Price × (1 + VAT%). Standard Price reflects AVCO/landed costs.</p>
                            <p style="margin:1px 0;">• Selling Price = sum of line unit prices × quantities (before session-level discounts).</p>
                        </div>

                    </div><!-- /page 1 -->
                </t><!-- /web.internal_layout page 1 -->

                <!-- ════════════════════════════════════════════════════
                     PAGE 2 — RECEIPTS DETAIL
                ════════════════════════════════════════════════════ -->
                <t t-call="web.internal_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #222;">

                        <!-- TITLE -->
                        <div style="text-align:center; background:#1A5E1A; color:#fff;
                                    padding:10px 0; margin-bottom:10px; border-radius:4px;">
                            <h2 style="margin:0; font-size:18px; letter-spacing:2px;">RECEIPTS DETAIL</h2>
                        </div>

                        <!-- SESSION HEADER -->
                        <table style="width:100%; margin-bottom:10px; border-collapse:collapse;">
                            <tr>
                                <td style="width:15%; font-weight:bold;">Shop:</td>
                                <td style="width:35%;"><t t-esc="doc['session'].config_id.name"/></td>
                                <td style="width:15%; font-weight:bold;">Opened (EAT):</td>
                                <td style="width:35%;"><t t-esc="doc['opened_at']"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Session:</td>
                                <td><t t-esc="doc['session'].name"/></td>
                                <td style="font-weight:bold;">Closed (EAT):</td>
                                <td><t t-esc="doc['closed_at']"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Cashier:</td>
                                <td><t t-esc="doc['session'].user_id.name"/></td>
                                <td></td><td></td>
                            </tr>
                        </table>

                        <!-- 1. Customer Account Deposits -->
                        <div style="background:#D5E8D4; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:6px; border-left:4px solid #1A5E1A;
                                    color:#1A5E1A;">
                            Customer Account Deposits
                        </div>
                        <t t-call="pos_session_z_report.receipts_subsection">
                            <t t-set="sub_title">DEPOSITS BY PAYMENT METHOD</t>
                            <t t-set="sub_rows" t-value="doc['receipts']['deposit_rows']"/>
                            <t t-set="sub_sym" t-value="doc['sym']"/>
                            <t t-set="sub_empty">No customer deposit payments in this session.</t>
                        </t>

                        <!-- 2. COD Order Payments -->
                        <div style="background:#D5E8D4; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:6px; border-left:4px solid #1A5E1A;
                                    color:#1A5E1A;">
                            COD Order Payments
                        </div>
                        <t t-call="pos_session_z_report.receipts_subsection">
                            <t t-set="sub_title">COD COLLECTIONS BY PAYMENT METHOD</t>
                            <t t-set="sub_rows" t-value="doc['receipts']['cod_rows']"/>
                            <t t-set="sub_sym" t-value="doc['sym']"/>
                            <t t-set="sub_empty">No COD order payments in this session.</t>
                        </t>

                        <!-- 3. Payments for Settle Due Accounts -->
                        <div style="background:#D5E8D4; padding:5px 8px; font-weight:bold;
                                    font-size:12px; margin-bottom:6px; border-left:4px solid #1A5E1A;
                                    color:#1A5E1A;">
                            Payments for Settle Due Accounts
                        </div>
                        <t t-call="pos_session_z_report.receipts_subsection">
                            <t t-set="sub_title">SETTLEMENTS BY PAYMENT METHOD</t>
                            <t t-set="sub_rows" t-value="doc['receipts']['settle_rows']"/>
                            <t t-set="sub_sym" t-value="doc['sym']"/>
                            <t t-set="sub_empty">No account settlement payments in this session.</t>
                        </t>

                        <!-- Page 2 footer note -->
                        <div style="margin-top:10px; font-size:8px; color:#888; border-top:1px solid #ccc; padding-top:4px;">
                            <p style="margin:1px 0;">• Deposit/Settle split based on partner credit balance at report generation time.</p>
                            <p style="margin:1px 0;">• COD collections sourced from pos.cod.collection records for this session.</p>
                            <p style="margin:1px 0;">• Values computed from order data at report generation time.</p>
                        </div>

                    </div><!-- /page 2 -->
                </t><!-- /web.internal_layout page 2 -->

            </t><!-- /foreach doc -->
        </t><!-- /html_container -->
    </template>

</odoo>
