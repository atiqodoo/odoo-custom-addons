<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_attachment_requirement_context" model="ir.ui.view">
        <field name="name">purchase.order.form.attachment.requirement.context</field>
        <field name="model">purchase.order</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_view_picking']" position="attributes">
                <attribute name="context">{'pnpc_require_attachment_before_receive_products': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
