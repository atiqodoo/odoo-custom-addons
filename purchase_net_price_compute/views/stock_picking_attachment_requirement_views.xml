<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_attachment_requirement_context" model="ir.ui.view">
        <field name="name">stock.picking.form.attachment.requirement.context</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_validate']" position="attributes">
                <attribute name="context">{'pnpc_require_attachment_before_validate_receipt': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
