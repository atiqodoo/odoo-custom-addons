<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_inherit_vendor_invoice_profile" model="ir.ui.view">
        <field name="name">res.partner.form.vendor.invoice.profile</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase_net_price_compute.res_partner_form_inherit_discount_freight"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='freight_percentage']" position="after">
                <field name="vendor_invoice_profile"
                       groups="purchase.group_purchase_manager"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="invoice_variance_currency_id" invisible="1"/>
                <field name="allowed_invoice_variance_amount"
                       groups="purchase.group_purchase_manager"
                       widget="monetary"/>
                <field name="variance_warning_dismiss_clicks_required"
                       groups="purchase.group_purchase_manager"/>
                <field name="block_invoice_variance_above_allowed"
                       groups="purchase.group_purchase_manager"/>
                <field name="require_vendor_invoice_final_total"
                       groups="purchase.group_purchase_manager"/>
                <field name="invoice_variance_allocation_mode"
                       groups="purchase.group_purchase_manager"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='freight_percentage']/ancestor::group[1]" position="after">
                <div class="alert alert-info" role="alert"
                     groups="purchase.group_purchase_manager"
                     invisible="supplier_rank == 0 or vendor_invoice_profile == 'standard'">
                    This vendor is mapped to a specialized invoice calculation profile.
                    The bill wizard will use that profile without matching the vendor name.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
