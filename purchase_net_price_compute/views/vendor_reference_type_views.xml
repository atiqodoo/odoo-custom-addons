<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_vendor_reference_type_list" model="ir.ui.view">
        <field name="name">purchase.vendor.reference.type.list</field>
        <field name="model">purchase.vendor.reference.type</field>
        <field name="arch" type="xml">
            <list string="Vendor Reference Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_vendor_reference_type_form" model="ir.ui.view">
        <field name="name">purchase.vendor.reference.type.form</field>
        <field name="model">purchase.vendor.reference.type</field>
        <field name="arch" type="xml">
            <form string="Vendor Reference Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_vendor_reference_type_search" model="ir.ui.view">
        <field name="name">purchase.vendor.reference.type.search</field>
        <field name="model">purchase.vendor.reference.type</field>
        <field name="arch" type="xml">
            <search string="Vendor Reference Types">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_vendor_reference_type" model="ir.actions.act_window">
        <field name="name">Vendor Reference Types</field>
        <field name="res_model">purchase.vendor.reference.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create vendor reference types such as Invoice, DNT, or Gatepass.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_vendor_reference_type"
              name="Vendor Reference Types"
              parent="purchase.menu_purchase_config"
              action="action_purchase_vendor_reference_type"
              sequence="55"
              groups="purchase.group_purchase_manager"/>
</odoo>
