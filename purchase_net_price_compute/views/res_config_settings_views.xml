<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_net_price" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.net.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="rfq_bill_price_check_count"
                         help="Use the lowest price from the last posted vendor bills for the selected product variant on RFQ lines. Set to 0 to disable.">
                    <field name="rfq_bill_price_check_count"/>
                </setting>
                <setting id="rfq_vendor_contact_usage_months"
                         help="Prioritize vendor contacts used on RFQs within the configured number of previous months. Set to 0 to use primary contacts first.">
                    <field name="rfq_vendor_contact_usage_months"/>
                </setting>
                <setting id="vendor_reference_required_settings"
                         string="Vendor Reference Requirements"
                         help="Choose where users must enter a vendor reference type and reference. All options are enabled by default.">
                    <div class="content-group">
                        <div class="row mt8">
                            <field name="vendor_reference_required_rfq"/>
                            <label for="vendor_reference_required_rfq"/>
                        </div>
                        <div class="row mt8">
                            <field name="vendor_reference_required_lpo"/>
                            <label for="vendor_reference_required_lpo"/>
                        </div>
                        <div class="row mt8">
                            <field name="vendor_reference_required_receipt"/>
                            <label for="vendor_reference_required_receipt"/>
                        </div>
                        <div class="row mt8">
                            <field name="vendor_reference_required_invoice"/>
                            <label for="vendor_reference_required_invoice"/>
                        </div>
                    </div>
                </setting>
                <setting id="lpo_report_display_settings"
                         string="LPO/RFQ PDF Display"
                         help="Control which commercial fields are printed on downloaded LPO/RFQ PDF reports.">
                    <div class="content-group">
                        <div class="row mt8">
                            <field name="lpo_report_show_cost"/>
                            <label for="lpo_report_show_cost"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_discount"/>
                            <label for="lpo_report_show_discount"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_tax"/>
                            <label for="lpo_report_show_tax"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_subtotal"/>
                            <label for="lpo_report_show_subtotal"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_total"/>
                            <label for="lpo_report_show_total"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_promotion"/>
                            <label for="lpo_report_show_promotion"/>
                        </div>
                        <div class="row mt8">
                            <field name="lpo_report_show_grade_volume"/>
                            <label for="lpo_report_show_grade_volume"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_lpo_stamp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lpo.stamp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='document_layout_setting']" position="after">
                <setting id="lpo_rubber_stamp_setting"
                         string="LPO Rubber Stamp"
                         help="Upload a transparent PNG rubber stamp to print on LPO reports."
                         company_dependent="1">
                    <field name="lpo_rubber_stamp_filename" invisible="1"/>
                    <field name="lpo_rubber_stamp_png"
                           widget="image"
                           filename="lpo_rubber_stamp_filename"
                           options="{'accepted_file_extensions': '.png'}"
                           class="oe_avatar"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
