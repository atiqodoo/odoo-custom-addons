<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="purchase_net_price_compute.TallyAttachments">
        <div class="o_pnpc_tally_attachments">
            <t t-set="attachmentFiles" t-value="this.files"/>
            <div t-if="attachmentFiles.length" class="d-flex align-items-center gap-2 mb-3">
                <button type="button" class="btn btn-secondary" title="Previous attachment"
                        t-att-disabled="attachmentFiles.length &lt; 2 || state.isSelecting"
                        t-on-click="() => this.navigate(-1)">
                    <i class="oi oi-chevron-left me-1" aria-hidden="true"/>Previous
                </button>
                <span aria-live="polite"><t t-out="this.selectedIndex + 1"/> / <t t-out="attachmentFiles.length"/></span>
                <button type="button" class="btn btn-secondary" title="Next attachment"
                        t-att-disabled="attachmentFiles.length &lt; 2 || state.isSelecting"
                        t-on-click="() => this.navigate(1)">
                    Next<i class="oi oi-chevron-right ms-1" aria-hidden="true"/>
                </button>
            </div>
            <div class="d-flex flex-wrap gap-2">
            <span t-if="!attachmentFiles.length" class="text-muted">No attachments on the source document.</span>
            <div t-foreach="attachmentFiles" t-as="file" t-key="file.id"
                 class="border rounded d-flex align-items-center gap-2 p-2"
                 t-att-class="{'border-primary bg-light': props.record.data.attachment_id?.[0] === file.id}">
                <button type="button" class="btn btn-link p-0"
                        t-att-disabled="state.isSelecting"
                        t-att-aria-pressed="props.record.data.attachment_id?.[0] === file.id ? 'true' : 'false'"
                        t-on-click="() => this.select(file)">
                    <i class="fa fa-paperclip me-1" aria-hidden="true"/>
                    <t t-out="file.displayName"/>
                </button>
                <a t-att-href="file.downloadUrl" download="" class="text-muted"
                   title="Download" aria-label="Download">
                    <i class="fa fa-download" aria-hidden="true"/>
                </a>
            </div>
            </div>
        </div>
    </t>
</templates>
