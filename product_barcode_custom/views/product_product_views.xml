<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define the action first to ensure the XML ID is registered -->
    <record id="action_generate_barcode_wizard" model="ir.actions.act_window">
        <field name="name">Generate Barcodes</field>
        <field name="res_model">product.barcode.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_product_ids': active_ids}</field>
    </record>

    <!-- Extend the Product Variants search to include nexx_barcode in the default "Product" field.
         The active search view for product.product is product_search_form_view (mode=primary),
         which overrides the name field with a 3-condition domain. We add nexx_barcode here. -->
    <record id="view_product_product_search_inherit_nexx_barcode" model="ir.ui.view">
        <field name="name">product.product.search.inherit.nexx.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('nexx_barcode', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add Nexx Barcode as an optional column in the Product Variants list view -->
    <record id="view_product_product_list_inherit_nexx_barcode" model="ir.ui.view">
        <field name="name">product.product.list.inherit.nexx.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="nexx_barcode"
                       string="Nexx Barcode (Nexx ERP)"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Define the variant form view after the action -->
    <record id="view_product_product_form_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(product_barcode_custom.action_generate_barcode_wizard)d" string="Generate Barcode" type="action" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="nexx_barcode"
                       string="Nexx Barcode (Nexx ERP)"
                       placeholder="e.g. NX-00012345"/>
            </xpath>
        </field>
    </record>
</odoo>