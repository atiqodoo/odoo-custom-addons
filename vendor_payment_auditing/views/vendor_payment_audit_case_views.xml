<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_payment_audit_case_list" model="ir.ui.view">
        <field name="name">vendor.payment.audit.case.list</field>
        <field name="model">vendor.payment.audit.case</field>
        <field name="arch" type="xml">
            <list decoration-danger="payment_blocked" decoration-muted="state == 'clear'">
                <field name="name"/>
                <field name="bill_id"/>
                <field name="vendor_id"/>
                <field name="state"/>
                <field name="blocking_finding_count"/>
                <field name="open_finding_count"/>
                <field name="policy_id"/>
                <field name="last_scan_at"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_payment_audit_case_form" model="ir.ui.view">
        <field name="name">vendor.payment.audit.case.form</field>
        <field name="model">vendor.payment.audit.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_scan"
                            type="object"
                            string="Re-evaluate"
                            class="btn-secondary"/>
                    <button name="action_approve_waiver"
                            type="object"
                            string="Approve Waiver"
                            class="btn-primary"
                            groups="vendor_payment_auditing.group_vendor_payment_audit_manager"
                            invisible="not payment_blocked"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not payment_blocked">
                        <strong>Payment blocked:</strong>
                        <field name="block_reason_summary" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="bill_id" readonly="1"/>
                            <field name="vendor_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="policy_id" readonly="1"/>
                            <field name="payment_blocked" readonly="1"/>
                            <field name="blocking_finding_count" readonly="1"/>
                            <field name="open_finding_count" readonly="1"/>
                            <field name="last_scan_at" readonly="1"/>
                            <field name="last_policy_eval_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings">
                            <field name="finding_ids">
                                <list decoration-danger="requires_payment_block and state == 'open'"
                                      decoration-muted="state in ('resolved', 'waived', 'obsolete')">
                                    <field name="requires_payment_block"/>
                                    <field name="name"/>
                                    <field name="variance_type_id"/>
                                    <field name="severity"/>
                                    <field name="variance_amount"/>
                                    <field name="matched_credit_note_amount"/>
                                    <field name="remaining_resolution_amount"/>
                                    <field name="resolution_tolerance_amount"/>
                                    <field name="variance_percent"/>
                                    <field name="resolution_requirement"/>
                                    <field name="state"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_mark_resolved"
                                                type="object"
                                                string="Mark Resolved"
                                                class="btn-primary"
                                                invisible="state != 'open'"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="variance_type_id" readonly="1"/>
                                                <field name="severity" readonly="1"/>
                                                <field name="state" readonly="1"/>
                                                <field name="requires_payment_block" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="product_id" readonly="1"/>
                                                <field name="invoice_line_id" readonly="1"/>
                                                <field name="expected_amount" readonly="1"/>
                                                <field name="actual_amount" readonly="1"/>
                                                <field name="variance_amount" readonly="1"/>
                                                <field name="matched_credit_note_amount" readonly="1"/>
                                                <field name="remaining_resolution_amount" readonly="1"/>
                                                <field name="resolution_tolerance_amount" readonly="1"/>
                                                <field name="variance_percent" readonly="1"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="policy_line_id" readonly="1"/>
                                            <field name="resolution_requirement" readonly="1"/>
                                            <field name="credit_note_id"/>
                                            <field name="waiver_reason"/>
                                        </group>
                                        <group string="Source">
                                            <field name="source_code" readonly="1"/>
                                            <field name="source_model" readonly="1"/>
                                            <field name="source_record_id" readonly="1"/>
                                            <field name="source_key" readonly="1"/>
                                        </group>
                                        <group string="Debug">
                                            <field name="debug_payload_json" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vendor_payment_audit_case_search" model="ir.ui.view">
        <field name="name">vendor.payment.audit.case.search</field>
        <field name="model">vendor.payment.audit.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="bill_id"/>
                <field name="vendor_id"/>
                <filter name="blocked" string="Blocked" domain="[('payment_blocked', '=', True)]"/>
                <filter name="open_findings" string="Open Findings" domain="[('open_finding_count', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_payment_audit_case" model="ir.actions.act_window">
        <field name="name">Vendor Payment Audit Cases</field>
        <field name="res_model">vendor.payment.audit.case</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_blocked': 1}</field>
    </record>
</odoo>
