<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vendor_payment_audit" model="ir.ui.view">
        <field name="name">account.move.form.vendor.payment.audit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vendor_payment_audit_scan"
                        type="object"
                        string="Re-evaluate Audit"
                        class="btn-secondary"
                        invisible="move_type != 'in_invoice' or state != 'posted'"/>
                <button name="action_view_vendor_payment_audit_case"
                        type="object"
                        string="Payment Audit"
                        class="btn-primary"
                        invisible="move_type != 'in_invoice'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="vendor_payment_audit_blocked" invisible="1"/>
                <field name="vendor_payment_audit_state" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="not vendor_payment_audit_blocked">
                    <strong>Vendor payment blocked:</strong>
                    <field name="vendor_payment_audit_block_reason" readonly="1"/>
                </div>
                <group string="Vendor Payment Audit" invisible="move_type != 'in_invoice'">
                    <field name="vendor_payment_audit_state" readonly="1"/>
                    <field name="vendor_payment_audit_finding_count" readonly="1"/>
                    <field name="vendor_payment_audit_block_reason" readonly="1"
                           invisible="not vendor_payment_audit_blocked"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
