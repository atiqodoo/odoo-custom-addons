<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_combined_lpo_bill_wizard_form" model="ir.ui.view">
        <field name="name">combined.lpo.bill.wizard.form</field>
        <field name="model">combined.lpo.bill.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Combined LPO Bill" class="o_vendor_bill_price_wizard">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="vendor_invoice_profile"/>
                            <field name="is_crown_profile" invisible="1"/>
                            <field name="is_gamma_profile" invisible="1"/>
                            <field name="has_promised_cost_discrepancy" invisible="1"/>
                            <field name="promised_cost_discrepancy_approved" invisible="1"/>
                            <field name="allowed_invoice_variance_amount" invisible="1"/>
                            <field name="required_variance_dismiss_count" invisible="1"/>
                            <field name="block_invoice_variance_above_allowed" invisible="1"/>
                            <field name="variance_policy_calculated_total" invisible="1"/>
                            <field name="variance_policy_vendor_final_total" invisible="1"/>
                            <field name="variance_policy_amount" invisible="1"/>
                            <field name="variance_policy_abs_amount" invisible="1"/>
                            <field name="variance_policy_exceeds_allowed" invisible="1"/>
                            <field name="variance_policy_requires_ack" invisible="1"/>
                            <field name="variance_policy_acknowledged" invisible="1"/>
                            <field name="invoice_variance_allocation_mode" invisible="1"/>
                            <field name="invoice_variance_allocation_enabled" invisible="1"/>
                        </group>
                        <group>
                            <field name="vendor_invoice_reference"/>
                            <field name="invoice_date"/>
                            <field name="bill_id"/>
                        </group>
                    </group>

                    <group string="Source LPOs">
                        <field name="purchase_ids"
                               widget="many2many_tags"
                               domain="[('partner_id.commercial_partner_id', '=', partner_id), ('company_id', '=', company_id), ('currency_id', '=', currency_id), ('state', 'in', ('purchase', 'done')), ('invoice_status', '=', 'to invoice'), ('has_combined_lpo_billable_qty', '=', True)]"/>
                    </group>

                    <group string="Combined Invoice Summary">
                        <group>
                            <field name="invoice_total_vat_incl" readonly="1" widget="monetary"/>
                            <field name="vendor_invoice_final_total" widget="monetary"/>
                            <field name="invoice_variance_amount"
                                   readonly="1"
                                   widget="monetary"
                                   decoration-success="invoice_variance_amount &gt; 0"
                                   decoration-danger="invoice_variance_amount &lt; 0"/>
                            <field name="invoice_variance_percentage" readonly="1"/>
                            <field name="invoice_status" readonly="1"/>
                            <field name="invoice_variance_allocation_mode" readonly="1"/>
                            <field name="invoice_allocation_ratio"
                                   invisible="not invoice_variance_allocation_enabled"
                                   readonly="1"/>
                            <field name="allowed_invoice_variance_amount" readonly="1"/>
                            <field name="variance_warning_dismiss_count" readonly="1"/>
                            <field name="required_variance_dismiss_count" readonly="1"/>
                        </group>
                        <group string="Promotion Fulfilment" invisible="not is_gamma_profile">
                            <field name="gamma_promotion_application_ids" widget="many2many_tags" readonly="1"/>
                            <field name="gamma_promised_foc_qty" readonly="1"/>
                            <field name="gamma_received_foc_qty" readonly="1"/>
                            <field name="gamma_outstanding_foc_qty"
                                   readonly="1"
                                   decoration-danger="gamma_outstanding_foc_qty &gt; 0"
                                   decoration-success="gamma_outstanding_foc_qty == 0"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="not variance_policy_requires_ack or variance_policy_acknowledged">
                        <strong>Invoice variance exceeds vendor allowed amount.</strong>
                        <field name="variance_policy_message" readonly="1" widget="text" nolabel="1"/>
                        <button string="Dismiss Warning"
                                name="action_dismiss_invoice_variance_warning"
                                type="object"
                                class="btn btn-secondary"/>
                    </div>

                    <group string="Line Column Visibility">
                        <field name="show_reference_columns" widget="boolean_toggle"/>
                        <field name="show_computed_line_columns" widget="boolean_toggle"/>
                        <field name="show_vat_line_columns" widget="boolean_toggle"/>
                        <field name="show_promised_cost_columns" widget="boolean_toggle"/>
                        <field name="show_profile_detail_columns" widget="boolean_toggle"/>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list editable="bottom"
                              decoration-muted="not include_line"
                              decoration-danger="promised_cost_difference_vat_incl &gt; 0"
                              decoration-success="promised_cost_difference_vat_incl &lt; 0">
                            <field name="include_line"/>
                            <field name="purchase_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty"/>
                            <field name="max_billable_qty"
                                   readonly="1"
                                   column_invisible="not parent.show_reference_columns"/>
                            <field name="product_uom_id"
                                   readonly="1"
                                   column_invisible="not parent.show_reference_columns"/>
                            <field name="po_unit_price"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.show_reference_columns"/>
                            <field name="vendor_price" widget="monetary"/>
                            <field name="vendor_line_total"
                                   widget="monetary"
                                   column_invisible="not parent.is_crown_profile"/>
                            <field name="applied_discount"/>
                            <field name="applied_freight" column_invisible="parent.is_gamma_profile"/>
                            <field name="gamma_tint_type" column_invisible="not parent.is_gamma_profile"/>
                            <field name="gamma_tint_percentage" column_invisible="not parent.is_gamma_profile"/>
                            <field name="bill_unit_price_excl_vat"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.show_computed_line_columns"/>
                            <field name="unit_price_vat_incl"
                                   readonly="1"
                                   widget="monetary"
                                   class="o_vpc_unit_price_vat_incl"
                                   column_invisible="not parent.show_vat_line_columns"/>
                            <field name="line_total_vat_incl"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.show_vat_line_columns"
                                   sum="Calculated Total"/>
                            <field name="final_unit_price_excl_vat"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.invoice_variance_allocation_enabled or not parent.show_computed_line_columns"/>
                            <field name="final_unit_price_incl_vat"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.invoice_variance_allocation_enabled or not parent.show_vat_line_columns"/>
                            <field name="final_line_total_vat_incl"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.invoice_variance_allocation_enabled or not parent.show_vat_line_columns"
                                   sum="Final Total"/>
                            <field name="vendor_promised_cost_vat_incl"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.show_promised_cost_columns"/>
                            <field name="promised_cost_difference_vat_incl"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.show_promised_cost_columns"
                                   decoration-danger="promised_cost_difference_vat_incl &gt; 0"
                                   decoration-success="promised_cost_difference_vat_incl &lt; 0"/>
                            <field name="gamma_gross_total"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.is_gamma_profile or not parent.show_profile_detail_columns"/>
                            <field name="gamma_discount_amount"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.is_gamma_profile or not parent.show_profile_detail_columns"/>
                            <field name="gamma_tint_charge"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.is_gamma_profile or not parent.show_profile_detail_columns"/>
                            <field name="structured_discount_amount"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.is_crown_profile or not parent.show_profile_detail_columns"/>
                            <field name="structured_discount_percentage"
                                   readonly="1"
                                   column_invisible="not parent.is_crown_profile or not parent.show_profile_detail_columns"/>
                            <field name="freight_amount"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.is_crown_profile or not parent.show_profile_detail_columns"/>
                            <field name="allocated_variance_amount"
                                   readonly="1"
                                   widget="monetary"
                                   column_invisible="not parent.invoice_variance_allocation_enabled or not parent.show_profile_detail_columns"/>
                            <field name="purchase_line_id" column_invisible="1"/>
                            <field name="purchase_tax_ids" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Reload Eligible Lines"
                            name="action_reload_lines"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Create/Update Combined Bill &amp; Validate Prices"
                            name="action_create_bill"
                            type="object"
                            class="btn-primary"
                            invisible="variance_policy_requires_ack and not variance_policy_acknowledged"/>
                    <button string="Approve Promised Cost Difference"
                            name="action_approve_promised_cost_discrepancy"
                            type="object"
                            class="btn-secondary"
                            invisible="not has_promised_cost_discrepancy or promised_cost_discrepancy_approved"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
