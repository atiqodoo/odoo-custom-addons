<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_combined_lpo_bill" model="ir.ui.view">
        <field name="name">account.move.form.combined.lpo.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="combined_lpo_bill_source" invisible="1"/>
                <group string="Combined LPO Bill Audit" invisible="not combined_lpo_bill_source">
                    <group>
                        <field name="combined_purchase_ids" widget="many2many_tags" readonly="1"/>
                        <field name="combined_lpo_origin_text" readonly="1"/>
                        <field name="combined_lpo_line_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="combined_lpo_debug_summary" readonly="1" widget="text"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="combined_lpo_source_purchase_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
