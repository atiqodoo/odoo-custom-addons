<odoo>
    <record id="view_upg_link_transfer_wizard" model="ir.ui.view">
        <field name="name">pos.uncleared.payment.link.transfer.wizard.form</field>
        <field name="model">pos.uncleared.payment.link.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Cheque Transfer">
                <p>Select the existing posted transfer for this cheque. Its reference can be blank. One whole cheque per transfer is supported; accounting entries are not changed.</p>
                <group>
                    <field name="hold_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="move_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_link" type="object" string="Link Transfer" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
