<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_upg_clear_wizard_form" model="ir.ui.view">
        <field name="name">pos.uncleared.payment.clear.wizard.form</field>
        <field name="model">pos.uncleared.payment.clear.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="hold_id"/>
                    <field name="partner_id"/>
                    <field name="payment_method_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="reference"/>
                    <field name="reason" placeholder="Required reason for manually clearing this uncleared payment."/>
                </group>
                <footer>
                    <button name="action_clear" type="object" string="Clear Hold" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
