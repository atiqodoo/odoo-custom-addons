<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="pos_uncleared_payment_guard.NavbarPatch"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//CashierName" position="before">
            <UnclearedPaymentBanner t-if="!ui.isSmall"/>
        </xpath>
    </t>

    <t t-name="pos_uncleared_payment_guard.UnclearedPaymentBanner">
        <button t-if="isVisible"
                class="btn btn-light btn-lg lh-lg d-flex align-items-center gap-1 text-warning"
                t-on-click="onClick"
                title="View uncleared POS payments">
            <i class="fa fa-fw fa-exclamation-circle"/>
            <span class="text-nowrap" t-esc="label"/>
        </button>
    </t>

    <t t-name="pos_uncleared_payment_guard.UnclearedPaymentCardsDialog">
        <Dialog size="'lg'">
            <t t-set-slot="header">
                <div class="modal-header">
                    <h4 class="modal-title">Uncleared POS Payments</h4>
                    <button type="button" class="btn-close" t-on-click="onClose"/>
                </div>
            </t>

            <t t-if="state.loading">
                <div class="d-flex align-items-center justify-content-center p-4 gap-2">
                    <span class="spinner-border spinner-border-sm text-warning"/>
                    <span>Loading uncleared payments...</span>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-danger m-3">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.error"/>
                </div>
            </t>
            <t t-elif="state.holds.length === 0">
                <div class="alert alert-success m-3 mb-0">No pending uncleared payments.</div>
            </t>
            <t t-else="">
                <div class="row g-3 p-3">
                    <t t-foreach="state.holds" t-as="hold" t-key="hold.id">
                        <div class="col-12 col-md-6">
                            <div class="card h-100 border-warning">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-bold text-truncate" t-esc="hold.partner"/>
                                            <div class="text-muted small" t-esc="hold.name"/>
                                        </div>
                                        <span class="badge text-bg-warning" t-esc="formatAmount(hold)"/>
                                    </div>
                                    <div class="mt-3 small">
                                        <div><span class="text-muted">Status:</span> <t t-esc="hold.state"/></div>
                                        <div><span class="text-muted">Method:</span> <t t-esc="hold.payment_method"/></div>
                                        <div t-if="hold.deposit_bank_journal"><span class="text-muted">Deposit Bank:</span> <t t-esc="hold.deposit_bank_journal"/></div>
                                        <div t-if="hold.cheque_bank"><span class="text-muted">Cheque Bank:</span> <t t-esc="hold.cheque_bank"/></div>
                                        <div t-if="hold.cheque_number"><span class="text-muted">Cheque No:</span> <t t-esc="hold.cheque_number"/></div>
                                        <div t-if="hold.cheque_date"><span class="text-muted">Cheque Date:</span> <t t-esc="hold.cheque_date"/></div>
                                        <div><span class="text-muted">Order:</span> <t t-esc="hold.order"/></div>
                                        <div><span class="text-muted">Session:</span> <t t-esc="hold.session"/></div>
                                        <div t-if="hold.transfer"><span class="text-muted">Transfer:</span> <t t-esc="hold.transfer"/></div>
                                        <div t-if="hold.statement_line"><span class="text-muted">Statement:</span> <t t-esc="hold.statement_line"/></div>
                                        <div><span class="text-muted">Created:</span> <t t-esc="hold.date"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="refresh">Refresh</button>
                <button class="btn btn-primary" t-on-click="onClose">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
