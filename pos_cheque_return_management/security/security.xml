<odoo>
    <record id="group_cheque_return_manager" model="res.groups">
        <field name="name">Cheque Return Reporter</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4,ref('pos_uncleared_payment_guard.group_pos_uncleared_payment_manager')),(4,ref('pos_cod_deposit_settlement.group_cod_deposit_manager')),(4,ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_cheque_return_accountant" model="res.groups">
        <field name="name">Cheque Return Accountant</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4,ref('group_cheque_return_manager')),(4,ref('account.group_account_user'))]"/>
    </record>
    <record id="attempt_company_rule" model="ir.rule">
        <field name="name">Cheque attempts: allowed companies</field><field name="model_id" ref="model_pos_cheque_bank_attempt"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="return_company_rule" model="ir.rule">
        <field name="name">Cheque returns: allowed companies</field><field name="model_id" ref="model_pos_cheque_bank_return"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="funding_company_rule" model="ir.rule">
        <field name="name">Cheque funding: allowed companies</field><field name="model_id" ref="model_pos_cheque_cod_funding"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="fee_company_rule" model="ir.rule">
        <field name="name">Cheque bank fees: allowed companies</field><field name="model_id" ref="model_pos_cheque_bank_fee"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <data noupdate="1">
        <record id="reason_insufficient_funds" model="pos.cheque.return.reason"><field name="name">Insufficient Funds</field><field name="allow_rebank">True</field></record>
        <record id="reason_technical" model="pos.cheque.return.reason"><field name="name">Technical / Authorization Rejection</field><field name="allow_rebank">True</field></record>
        <record id="reason_suspected_fraud" model="pos.cheque.return.reason"><field name="name">Suspected Fraud / Invalid Cheque</field><field name="investigation_required">True</field></record>
    </data>
</odoo>
