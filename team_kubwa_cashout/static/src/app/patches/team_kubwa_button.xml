<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="team_kubwa_cashout.ProductScreenButton" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ControlButtons" position="after">
            <button t-if="teamKubwaButtonVisible and !ui.isSmall" class="btn btn-light btn-lg lh-lg team-kubwa-open-button" t-on-click="onTeamKubwaButtonClick">
                <i class="fa fa-money me-1" role="img" aria-label="Team Kubwa" title="Team Kubwa Cash-Out"/>
                Team Kubwa
            </button>
        </xpath>
    </t>
</templates>

