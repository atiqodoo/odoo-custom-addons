<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_team_kubwa" model="ir.module.category">
        <field name="name">Team Kubwa</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_team_kubwa_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="team_kubwa_cashout.module_category_team_kubwa"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="group_team_kubwa_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="team_kubwa_cashout.module_category_team_kubwa"/>
        <field name="implied_ids" eval="[(4, ref('team_kubwa_cashout.group_team_kubwa_cashier'))]"/>
    </record>
    <record id="group_team_kubwa_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="team_kubwa_cashout.module_category_team_kubwa"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>

