<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_modern_quotation_user" model="res.groups">
        <field name="name">Modern Quotation User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_modern_quotation_manager" model="res.groups">
        <field name="name">Modern Quotation Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('modern_quotation_catalogue.group_modern_quotation_user')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="group_modern_quotation_cost_viewer" model="res.groups">
        <field name="name">Modern Quotation: View Cost and Margin</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('modern_quotation_catalogue.group_modern_quotation_user'))]"/>
    </record>
</odoo>
