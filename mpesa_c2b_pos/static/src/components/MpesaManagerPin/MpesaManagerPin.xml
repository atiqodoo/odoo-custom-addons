<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="mpesa_c2b_pos.MpesaManagerPin">
        <div class="mpesa-overlay">
            <div class="mpesa-pin-dialog">
                <div class="mpesa-pin-header">
                    <span class="mpesa-pin-icon">&#128274;</span>
                    <h3>Manager Override Required</h3>
                </div>

                <p class="mpesa-pin-reason" t-esc="props.reason"/>

                <div class="mpesa-pin-input-row">
                    <input
                        type="password"
                        class="mpesa-pin-input"
                        placeholder="Manager PIN"
                        t-ref="pinInput"
                        t-on-keyup="onKeyUp"
                        maxlength="6"
                        autocomplete="off"
                    />
                </div>

                <div t-if="state.error" class="mpesa-pin-error" t-esc="state.error"/>

                <div class="mpesa-pin-actions">
                    <button class="mpesa-btn mpesa-btn--secondary" t-on-click="onCancel">
                        Cancel
                    </button>
                    <button class="mpesa-btn mpesa-btn--primary" t-on-click="onConfirm">
                        Confirm Override
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
