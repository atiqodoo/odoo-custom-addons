<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add M-Pesa fields to the payment method form -->
    <record id="view_pos_payment_method_mpesa" model="ir.ui.view">
        <field name="name">pos.payment.method.mpesa</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="M-Pesa C2B">
                    <field name="is_mpesa" widget="boolean_toggle"/>
                </group>
                <group string="M-Pesa C2B Settings" invisible="not is_mpesa">
                    <group>
                        <field name="mpesa_lock_minutes"
                               invisible="not is_mpesa"/>
                        <field name="mpesa_amount_tolerance"
                               invisible="not is_mpesa"/>
                    </group>
                    <group>
                        <field name="mpesa_allow_overpayment"
                               invisible="not is_mpesa"/>
                        <field name="mpesa_allow_partial"
                               invisible="not is_mpesa"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
