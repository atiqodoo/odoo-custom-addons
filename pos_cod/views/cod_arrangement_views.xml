<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cod_arrangement_list" model="ir.ui.view">
        <field name="name">pos.cod.promise.arrangement.list</field>
        <field name="model">pos.cod.promise.arrangement</field>
        <field name="arch" type="xml">
            <list string="COD Customer Arrangements" create="0" edit="0" delete="0" default_order="arranged_at desc">
                <field name="arranged_at"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="arrangement_type"/>
                <field name="previous_promised_at" optional="hide"/>
                <field name="promised_at"/>
                <field name="promised_amount" widget="monetary"/>
                <field name="amount_paid_at_arrangement" widget="monetary" optional="hide"/>
                <field name="amount_collected_by_due" widget="monetary"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'kept'"
                       decoration-danger="outcome in ('broken', 'late_paid')"
                       decoration-warning="outcome == 'partially_kept'"
                       decoration-info="outcome == 'active'"/>
                <field name="commitment_result" widget="badge"/>
                <field name="arranged_by_id" optional="show"/>
                <field name="session_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cod_arrangement_form" model="ir.ui.view">
        <field name="name">pos.cod.promise.arrangement.form</field>
        <field name="model">pos.cod.promise.arrangement</field>
        <field name="arch" type="xml">
            <form string="COD Customer Arrangement" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="arrangement_type"/>
                            <field name="sequence"/>
                            <field name="customer_commitment"/>
                        </group>
                        <group>
                            <field name="arranged_at"/>
                            <field name="arranged_by_id"/>
                            <field name="session_id"/>
                            <field name="config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="previous_promised_at"/>
                            <field name="promised_at"/>
                            <field name="resolved_at"/>
                        </group>
                        <group>
                            <field name="promised_amount" widget="monetary"/>
                            <field name="amount_paid_at_arrangement" widget="monetary"/>
                            <field name="amount_collected_by_due" widget="monetary"/>
                            <field name="outcome"/>
                            <field name="commitment_result"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Customer Arrangement Note">
                        <field name="arrangement_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_cod_arrangement_search" model="ir.ui.view">
        <field name="name">pos.cod.promise.arrangement.search</field>
        <field name="model">pos.cod.promise.arrangement</field>
        <field name="arch" type="xml">
            <search string="COD Customer Arrangements">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="arranged_by_id"/>
                <field name="arrangement_note"/>
                <filter string="Promise Date" name="promised_at" date="promised_at"/>
                <separator/>
                <filter string="Success" name="success" domain="[('commitment_result', '=', 'success')]"/>
                <filter string="Failure" name="failure" domain="[('commitment_result', '=', 'failure')]"/>
                <filter string="Pending" name="pending" domain="[('commitment_result', '=', 'pending')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Outcome" name="group_outcome" context="{'group_by': 'outcome'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'commitment_result'}"/>
                    <filter string="Promise Month" name="group_promise_month" context="{'group_by': 'promised_at:month'}"/>
                    <filter string="Cashier" name="group_cashier" context="{'group_by': 'arranged_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pos_cod_arrangement_pivot" model="ir.ui.view">
        <field name="name">pos.cod.promise.arrangement.pivot</field>
        <field name="model">pos.cod.promise.arrangement</field>
        <field name="arch" type="xml">
            <pivot string="COD Commitment Analysis">
                <field name="partner_id" type="row"/>
                <field name="commitment_result" type="col"/>
                <field name="promised_amount" type="measure"/>
                <field name="amount_collected_by_due" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pos_cod_arrangements" model="ir.actions.act_window">
        <field name="name">COD Arrangements</field>
        <field name="res_model">pos.cod.promise.arrangement</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_pos_cod_arrangement_search"/>
    </record>

    <menuitem id="menu_pos_cod_arrangements" name="COD Arrangements"
              parent="point_of_sale.menu_point_root" action="action_pos_cod_arrangements"
              sequence="26" groups="point_of_sale.group_pos_user"/>

    <record id="pos_order_cod_arrangement_history" model="ir.ui.view">
        <field name="name">pos.order.cod.arrangement.history</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="pos_cod.view_pos_order_form_inherit_cod"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="not is_cod">
                    <page string="Customer Arrangements" name="cod_customer_arrangements">
                        <field name="cod_arrangement_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="sequence"/>
                                <field name="arranged_at"/>
                                <field name="arrangement_type"/>
                                <field name="promised_at"/>
                                <field name="arrangement_note"/>
                                <field name="outcome" widget="badge"/>
                                <field name="commitment_result" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
