<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_price_wizard_form_gamma_profile" model="ir.ui.view">
        <field name="name">vendor.price.wizard.form.gamma.profile</field>
        <field name="model">vendor.price.wizard</field>
        <field name="inherit_id" ref="vendor_price_check.view_vendor_price_wizard_form_crown_profile"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_crown_profile']" position="after">
                <field name="is_gamma_profile" invisible="1"/>
                <field name="gamma_promotion_application_ids" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/ancestor::group[1]" position="before">
                <div class="alert alert-info" role="alert" invisible="not is_gamma_profile">
                    <strong>Gamma invoice calculation:</strong>
                    bill quantity is the received charged quantity. FOC products are tracked on their linked
                    zero-cost PO line and never added to the payable amount. Tint charges use the original gross price.
                </div>
                <group string="Gamma Invoice and FOC Summary" invisible="not is_gamma_profile">
                    <group>
                        <field name="invoice_total_vat_incl"
                               string="Calculated Total (VAT Incl.)"
                               readonly="1"
                               widget="monetary"/>
                        <field name="gamma_vendor_invoice_final_total"
                               required="is_gamma_profile"
                               widget="monetary"/>
                        <field name="gamma_invoice_difference" readonly="1" widget="monetary"/>
                        <field name="gamma_invoice_status" readonly="1"/>
                    </group>
                    <group string="Promotion Fulfilment">
                        <field name="gamma_promised_foc_qty" readonly="1"/>
                        <field name="gamma_received_foc_qty" readonly="1"/>
                        <field name="gamma_outstanding_foc_qty"
                               readonly="1"
                               decoration-danger="gamma_outstanding_foc_qty &gt; 0"
                               decoration-success="gamma_outstanding_foc_qty == 0"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='vendor_price']" position="attributes">
                <attribute name="string">Vendor List Unit Price</attribute>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='vendor_price']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='applied_discount']" position="move"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='vendor_line_total']" position="after">
                <field name="gamma_tint_type"
                       column_invisible="not parent.is_gamma_profile"/>
                <field name="gamma_tint_percentage"
                       column_invisible="not parent.is_gamma_profile"/>
                <field name="gamma_gross_total"
                       widget="monetary"
                       readonly="1"
                       column_invisible="not parent.is_gamma_profile"/>
                <field name="gamma_discount_amount"
                       widget="monetary"
                       readonly="1"
                       column_invisible="not parent.is_gamma_profile"/>
                <field name="gamma_tint_charge"
                       widget="monetary"
                       readonly="1"
                       column_invisible="not parent.is_gamma_profile"/>
                <field name="gamma_subtotal_excl_vat"
                       widget="monetary"
                       readonly="1"
                       column_invisible="not parent.is_gamma_profile"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='applied_discount']" position="attributes">
                <attribute name="string">Discount %</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='applied_freight']" position="attributes">
                <attribute name="column_invisible">parent.is_gamma_profile</attribute>
            </xpath>
        </field>
    </record>
</odoo>
