<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vendor_promotion_hold" model="ir.ui.view">
        <field name="name">account.move.form.vendor.promotion.hold</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve_promotion_release"
                        type="object"
                        string="Approve FOC &amp; Release"
                        class="btn-primary"
                        groups="account.group_account_manager,purchase.group_purchase_manager"
                        invisible="not promotion_payment_hold or promotion_outstanding_foc_qty &gt; 0"/>
                <button name="action_waive_promotion_hold"
                        type="object"
                        string="Waive FOC &amp; Release"
                        class="btn-secondary"
                        groups="account.group_account_manager,purchase.group_purchase_manager"
                        invisible="not promotion_payment_hold"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="promotion_payment_hold" invisible="1"/>
                <field name="promotion_release_state" invisible="1"/>
                <field name="promotion_outstanding_foc_qty" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="not promotion_payment_hold">
                    <strong>Payment blocked by vendor promotion:</strong>
                    <field name="promotion_hold_reason" readonly="1" class="oe_inline"/>
                </div>
                <group string="Vendor Promotion Payment Control"
                       invisible="not promotion_application_ids">
                    <group>
                        <field name="promotion_application_ids" widget="many2many_tags" readonly="1"/>
                        <field name="promotion_release_state" readonly="1"/>
                        <field name="promotion_promised_foc_qty" readonly="1"/>
                        <field name="promotion_received_foc_qty" readonly="1"/>
                        <field name="promotion_outstanding_foc_qty" readonly="1"/>
                    </group>
                    <group>
                        <field name="promotion_release_reason"
                               placeholder="Required when waiving outstanding FOC..."
                               readonly="not promotion_payment_hold"
                               groups="account.group_account_manager,purchase.group_purchase_manager"/>
                        <field name="promotion_release_approved_by_id" readonly="1"/>
                        <field name="promotion_release_approved_at" readonly="1"/>
                    </group>
                </group>
                <group string="Gamma Invoice Audit" invisible="vendor_invoice_profile != 'gamma_paints'">
                    <field name="gamma_vendor_calculated_total_vat_incl" widget="monetary" readonly="1"/>
                    <field name="gamma_vendor_invoice_final_total" widget="monetary" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="gamma_invoice_list_unit_price" optional="hide"/>
                <field name="gamma_invoice_discount_percentage" optional="hide"/>
                <field name="gamma_invoice_tint_type" optional="hide"/>
                <field name="gamma_invoice_tint_percentage" optional="hide"/>
                <field name="gamma_invoice_tint_charge" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

