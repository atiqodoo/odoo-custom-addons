<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_promotions"
              inherit_id="purchase_net_price_compute.report_purchaseorder_document_lpo_no_cost"
              priority="10000010">
        <xpath expr="//th[@name='th_uom']" position="after">
            <th name="th_vendor_promotion" t-if="o._lpo_report_show_promotion()"><strong>Promotion</strong></th>
        </xpath>
        <xpath expr="//td[span[@t-out='line.product_uom.name']]" position="after">
            <td t-if="o._lpo_report_show_promotion()">
                <t t-if="line.is_promotion_foc">
                    <strong>FOC</strong>
                    <span t-if="line.promotion_id"> - <t t-out="line.promotion_id.name"/></span>
                </t>
                <t t-elif="line.promotion_id">
                    <span t-out="line.promotion_id.name"/>
                    <div class="text-muted">
                        Charged: <span t-out="o._lpo_report_format_float(line.product_qty, 2)"/>
                        | FOC: <span t-out="o._lpo_report_format_float(line.promotion_foc_qty, 2)"/>
                        | Total: <span t-out="o._lpo_report_format_float(line.promotion_total_expected_qty, 2)"/>
                    </div>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
