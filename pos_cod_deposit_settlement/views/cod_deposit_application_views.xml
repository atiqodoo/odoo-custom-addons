<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cod_deposit_application_list" model="ir.ui.view">
        <field name="name">pos.cod.deposit.application.list</field>
        <field name="model">pos.cod.deposit.application</field>
        <field name="arch" type="xml">
            <list string="COD Deposit Applications" create="false" edit="false" delete="false"
                  decoration-success="state == 'posted'" default_order="create_date desc">
                <field name="name"/>
                <field name="create_date"/>
                <field name="order_id"/>
                <field name="commercial_partner_id" string="Customer"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="deposit_before" optional="show"/>
                <field name="deposit_after" optional="show"/>
                <field name="cod_open_before" optional="show"/>
                <field name="cod_open_after" optional="show"/>
                <field name="pos_session_id" optional="show"/>
                <field name="cashier_id" optional="show"/>
                <field name="move_id"/>
                <field name="transaction_log_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cod_deposit_application_form" model="ir.ui.view">
        <field name="name">pos.cod.deposit.application.form</field>
        <field name="model">pos.cod.deposit.application</field>
        <field name="arch" type="xml">
            <form string="COD Deposit Application" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Operation">
                            <field name="state" widget="badge"/>
                            <field name="operation_uuid"/>
                            <field name="reservation_id"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="commercial_partner_id"/>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="POS Audit">
                            <field name="pos_config_id"/>
                            <field name="pos_session_id"/>
                            <field name="cashier_id"/>
                            <field name="create_date"/>
                            <field name="move_id"/>
                            <field name="transaction_log_id"/>
                            <field name="transfer_journal_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer Deposit">
                            <field name="requested_amount"/>
                            <field name="amount"/>
                            <field name="deposit_before"/>
                            <field name="deposit_after"/>
                            <field name="default_receivable_account_id"/>
                            <field name="bridge_receivable_line_id"/>
                        </group>
                        <group string="COD Receivable">
                            <field name="cod_open_before"/>
                            <field name="cod_open_after"/>
                            <field name="cod_receivable_account_id"/>
                            <field name="bridge_cod_line_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Source Customer Credits">
                            <field name="source_credit_line_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="amount_residual"/>
                                    <field name="reconciled"/>
                                </list>
                            </field>
                        </page>
                        <page string="Netted POS Invoice Debits">
                            <field name="source_pos_invoice_debit_line_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="ref"/>
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="amount_residual"/>
                                    <field name="reconciled"/>
                                </list>
                            </field>
                        </page>
                        <page string="Source COD Receivable">
                            <field name="cod_source_line_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="amount_residual"/>
                                    <field name="reconciled"/>
                                </list>
                            </field>
                        </page>
                        <page string="Debug Snapshot" groups="pos_cod_deposit_settlement.group_cod_deposit_manager">
                            <field name="debug_snapshot" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cod_deposit_application_search" model="ir.ui.view">
        <field name="name">pos.cod.deposit.application.search</field>
        <field name="model">pos.cod.deposit.application</field>
        <field name="arch" type="xml">
            <search string="COD Deposit Applications">
                <field name="name"/>
                <field name="order_id"/>
                <field name="commercial_partner_id"/>
                <field name="move_id"/>
                <field name="operation_uuid"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'commercial_partner_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'pos_session_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cod_deposit_applications" model="ir.actions.act_window">
        <field name="name">Deposit Applications</field>
        <field name="res_model">pos.cod.deposit.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cod_deposit_application_search"/>
    </record>
</odoo>
