<odoo><record id="workflow_form" model="ir.ui.view"><field name="name">account.cheque.workflow.form</field><field name="model">account.cheque.workflow</field><field name="arch" type="xml">
        <form string="Cheque Action"><group>
    <field name="leaf_id" readonly="1"/><field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/><field name="action"/><field name="date"/>
    <field name="reason_id" invisible="action != 'report'" required="action == 'report'"/>
    <field name="statement_id" invisible="action not in ('clear','correct','report')" required="action == 'clear'" domain="[('company_id','=',company_id)]"/>
    <field name="reference" invisible="action not in ('deliver','stop_confirm')" required="action in ('deliver','stop_confirm')"/>
    <field name="replacement_leaf_id" invisible="action != 'replace'" required="action == 'replace'" domain="[('company_id','=',company_id),('state','=','available')]" options="{'no_create':True}"/>
    <field name="replacement_amount" invisible="action != 'replace'"/>
    <field name="instrument_recovered" invisible="action not in ('replace','void')"/>
    <field name="note"/>
    </group><footer><button name="action_apply" type="object" string="Apply" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record></odoo>
