<odoo>
    <record id="group_cheque_user" model="res.groups">
        <field name="name">Cheque Book Operator</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_cheque_accountant" model="res.groups">
        <field name="name">Cheque Book Accountant</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_cheque_user'))]"/>
    </record>
    <record id="group_cheque_manager" model="res.groups">
        <field name="name">Cheque Book Manager</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_cheque_accountant'))]"/>
    </record>
    <record id="book_company_rule" model="ir.rule"><field name="name">Cheque books: allowed companies</field><field name="model_id" ref="model_account_cheque_book"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="leaf_company_rule" model="ir.rule"><field name="name">Cheque leaves: allowed companies</field><field name="model_id" ref="model_account_cheque_leaf"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="attempt_company_rule" model="ir.rule"><field name="name">Cheque attempts: allowed companies</field><field name="model_id" ref="model_account_cheque_attempt"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="event_company_rule" model="ir.rule"><field name="name">Cheque events: allowed companies</field><field name="model_id" ref="model_account_cheque_event"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="fee_company_rule" model="ir.rule"><field name="name">Cheque fees: allowed companies</field><field name="model_id" ref="model_account_cheque_fee"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
