<odoo>
    <record id="journal_cheque_books" model="ir.ui.view"><field name="name">account.journal.cheque.books</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_form"/><field name="arch" type="xml">
        <xpath expr="//notebook" position="inside"><page string="Cheque Books" invisible="type != 'bank'" groups="account_cheque_book_management.group_cheque_manager"><group><field name="cheque_book_enabled"/></group><field name="cheque_book_ids" context="{'default_journal_id': id, 'default_company_id': company_id}" readonly="not cheque_book_enabled"><list><field name="name"/><field name="first_number"/><field name="leaf_count"/><field name="available_count"/><field name="state"/></list></field></page></xpath>
    </field></record>
    <record id="payment_cheque_books" model="ir.ui.view"><field name="name">account.payment.cheque.books</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_form"/><field name="arch" type="xml">
        <xpath expr="//field[@name='payment_method_line_id']" position="after">
            <field name="cheque_managed" invisible="1"/>
            <field name="cheque_book_id" invisible="not cheque_managed" required="cheque_managed" readonly="cheque_attempt_ids" domain="[('journal_id','=',journal_id),('state','=','active')]" options="{'no_create': True}"/>
            <field name="cheque_leaf_id" invisible="not cheque_managed" required="cheque_managed" readonly="cheque_attempt_ids" domain="[('book_id','=',cheque_book_id),('state','=','available')]" options="{'no_create': True}"/>
            <field name="cheque_date" invisible="not cheque_managed" required="cheque_managed" readonly="cheque_attempt_ids"/>
            <field name="cheque_attempt_ids" invisible="not cheque_managed or not cheque_attempt_ids" readonly="1" widget="one2many"/>
        </xpath>
    </field></record>
    <record id="register_cheque_books" model="ir.ui.view"><field name="name">account.payment.register.cheque.books</field><field name="model">account.payment.register</field><field name="inherit_id" ref="account.view_account_payment_register_form"/><field name="arch" type="xml">
        <xpath expr="//field[@name='payment_method_line_id']" position="after">
            <field name="cheque_managed" invisible="1"/>
            <field name="cheque_book_id" invisible="not cheque_managed" required="cheque_managed" domain="[('journal_id','=',journal_id),('state','=','active')]" options="{'no_create': True}"/>
            <field name="cheque_leaf_id" invisible="not cheque_managed" required="cheque_managed" domain="[('book_id','=',cheque_book_id),('state','=','available')]" options="{'no_create': True}"/>
            <field name="cheque_date" invisible="not cheque_managed" required="cheque_managed"/>
            <div class="text-muted" colspan="2" invisible="not cheque_managed">One leaf per payment. Group eligible bills for one vendor, or pay separately.</div>
        </xpath>
    </field></record>
</odoo>
