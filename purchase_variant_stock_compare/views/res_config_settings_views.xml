<odoo>
    <record id="purchase_settings_stock_compare" model="ir.ui.view">
        <field name="name">purchase.settings.stock.compare</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Variant Stock Comparison" name="variant_stock_comparison">
                    <setting string="Comparison result limit" help="Maximum similar products per comparison; the original is always included.">
                        <field name="variant_compare_limit"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
