<odoo>
    <record id="variant_compare_company_rule" model="ir.rule">
        <field name="name">Variant comparison company</field>
        <field name="model_id" ref="model_purchase_variant_stock_compare"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="variant_compare_line_company_rule" model="ir.rule">
        <field name="name">Variant comparison result company</field>
        <field name="model_id" ref="model_purchase_variant_stock_compare_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
