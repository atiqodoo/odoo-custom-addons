<odoo>
    <record id="variant_stock_compare_form" model="ir.ui.view">
        <field name="name">purchase.variant.stock.compare.form</field>
        <field name="model">purchase.variant.stock.compare</field>
        <field name="arch" type="xml">
            <form string="Compare Similar Stock" create="0">
                <field name="order_line_id" invisible="1"/>
                <field name="orderpoint_id" invisible="1"/>
                <group>
                    <group><field name="product_id"/><field name="company_id"/><field name="location_id"/></group>
                    <group><field name="use_category_group"/>
                        <field name="category_id" invisible="use_category_group"/>
                        <field name="category_group_id" invisible="not use_category_group" required="use_category_group"/>
                        <field name="uom_id"/><field name="colour_group_id"/></group>
                </group>
                <div class="alert alert-info"><field name="match_description" nolabel="1"/> Similarity is a comparison aid; verify finish and intended use before substituting.</div>
                <div class="alert alert-warning" invisible="not truncated">Result limit reached. Narrow the filters to see other matches.</div>
                <field name="truncated" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list create="0" edit="0" delete="0" decoration-info="is_original" decoration-danger="on_hand &lt; 0">
                        <field name="is_original" string="Original"/><field name="product_id"/>
                        <field name="category_id" optional="show"/><field name="uom_id"/>
                        <field name="colour_code_id" optional="show"/>
                        <field name="on_hand"/><field name="reserved"/><field name="free_qty"/>
                        <field name="incoming_qty"/><field name="forecast_qty"/>
                        <button name="action_open_quants" type="object" string="Locations" icon="fa-cubes"/>
                    </list>
                </field>
                <footer><button name="action_refresh" type="object" string="Refresh Stock" class="btn-primary"/><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
