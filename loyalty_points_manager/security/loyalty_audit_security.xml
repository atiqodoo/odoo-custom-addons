<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_loyalty_auditor" model="res.groups">
        <field name="name">Loyalty Audit</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_loyalty_auditor'))]"/>
    </record>
    <record id="audit_event_company_rule" model="ir.rule">
        <field name="name">Loyalty audit events: allowed companies</field>
        <field name="model_id" ref="model_loyalty_audit_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="audit_line_company_rule" model="ir.rule">
        <field name="name">Loyalty audit lines: allowed companies</field>
        <field name="model_id" ref="model_loyalty_audit_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="audit_condition_company_rule" model="ir.rule">
        <field name="name">Loyalty audit conditions: allowed companies</field>
        <field name="model_id" ref="model_loyalty_audit_condition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="customer_report_company_rule" model="ir.rule">
        <field name="name">Loyalty customer reporting: allowed companies</field>
        <field name="model_id" ref="model_loyalty_customer_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="movement_report_company_rule" model="ir.rule">
        <field name="name">Loyalty movement reporting: allowed companies</field>
        <field name="model_id" ref="model_loyalty_movement_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
