<odoo>
    <record id="sound_company_rule" model="ir.rule">
        <field name="name">Shared or company alarm sounds</field><field name="model_id" ref="model_native_alarm_sound"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_alarm_manager" model="res.groups">
        <field name="name">Alarm Administrator</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_alarm_companion" model="res.groups">
        <field name="name">Alarm Companion Account</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_alarm_manager'))]"/>
    </record>
    <record id="alarm_company_rule" model="ir.rule">
        <field name="name">Alarm company boundary</field><field name="model_id" ref="model_native_alarm"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="alarm_owner_rule" model="ir.rule">
        <field name="name">Own alarms</field><field name="model_id" ref="model_native_alarm"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="alarm_manager_rule" model="ir.rule">
        <field name="name">Manage company alarms</field><field name="model_id" ref="model_native_alarm"/>
        <field name="groups" eval="[(4, ref('group_alarm_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="device_company_rule" model="ir.rule">
        <field name="name">Alarm PC company boundary</field><field name="model_id" ref="model_native_alarm_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="device_user_rule" model="ir.rule">
        <field name="name">Authorised alarm PCs</field><field name="model_id" ref="model_native_alarm_device"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('allowed_user_ids', 'in', user.id), ('service_user_id', '=', user.id)]</field>
    </record>
    <record id="device_manager_rule" model="ir.rule">
        <field name="name">Manage company alarm PCs</field><field name="model_id" ref="model_native_alarm_device"/>
        <field name="groups" eval="[(4, ref('group_alarm_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
