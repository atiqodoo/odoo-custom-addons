<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Release POS locks that have expired (every 5 minutes) -->
        <record id="cron_release_pos_locks" model="ir.cron">
            <field name="name">M-Pesa: Release Expired POS Locks</field>
            <field name="model_id" ref="model_mpesa_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_release_expired_pos_locks()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">1</field>
        </record>

        <!-- Purge health records older than 7 days (daily) -->
        <record id="cron_purge_health_records" model="ir.cron">
            <field name="name">M-Pesa: Purge Old Modem Health Records</field>
            <field name="model_id" ref="model_mpesa_modem_health"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_records()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">1</field>
        </record>

    </data>
</odoo>
