<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mpesa_refund_case_list" model="ir.ui.view">
        <field name="name">mpesa.transaction.refund.case.list</field>
        <field name="model">mpesa.transaction.refund.case</field>
        <field name="arch" type="xml">
            <list string="M-Pesa Refund/Dispute Cases"
                  decoration-success="state in ('paid','reversed','won')"
                  decoration-warning="state in ('requested','approved','under_review','accepted','objected')"
                  decoration-danger="state=='lost'"
                  decoration-muted="state in ('rejected','cancelled')">
                <field name="name"/>
                <field name="case_type"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('paid','reversed','won')"
                       decoration-warning="state in ('requested','approved','under_review','accepted','objected')"
                       decoration-danger="state=='lost'"
                       decoration-muted="state in ('rejected','cancelled')"/>
                <field name="mpesa_ref"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="refund_journal_id"/>
                <field name="safaricom_case_ref"/>
                <field name="refund_payment_ref"/>
                <field name="move_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_refund_case_form" model="ir.ui.view">
        <field name="name">mpesa.transaction.refund.case.form</field>
        <field name="model">mpesa.transaction.refund.case</field>
        <field name="arch" type="xml">
            <form string="M-Pesa Refund/Dispute Case">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Refund" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'internal_refund' or state != 'requested'"/>
                    <button name="action_mark_refund_paid" string="Mark Refund Paid" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'internal_refund' or state != 'approved'"/>
                    <button name="action_accept_reversal" string="Accept Reversal" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'safaricom_reversal' or state != 'under_review'"/>
                    <button name="action_object_reversal" string="Object Reversal" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'safaricom_reversal' or state != 'under_review'"/>
                    <button name="action_mark_reversed" string="Mark Reversed" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'safaricom_reversal' or state not in ('accepted','objected')"/>
                    <button name="action_mark_won" string="Dispute Won" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'safaricom_reversal' or state != 'objected'"/>
                    <button name="action_mark_lost" string="Dispute Lost" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="case_type != 'safaricom_reversal' or state != 'objected'"/>
                    <button name="action_reject" string="Reject" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_refund_approver"
                            invisible="state not in ('draft','requested','under_review')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            groups="mpesa_c2b_sms.group_mpesa_manager"
                            invisible="state not in ('draft','requested','under_review')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_transaction"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-mobile">
                            <field name="mpesa_ref" widget="statinfo" string="Transaction"/>
                        </button>
                    </div>
                    <group>
                        <group string="Case">
                            <field name="name"/>
                            <field name="case_type"/>
                            <field name="transaction_id"/>
                            <field name="mpesa_ref"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="References">
                            <field name="safaricom_case_ref"
                                   invisible="case_type != 'safaricom_reversal'"/>
                            <field name="refund_payment_ref"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Accounting">
                            <field name="refund_journal_id"/>
                            <field name="counterpart_account_id"/>
                            <field name="loss_account_id"
                                   invisible="case_type != 'safaricom_reversal'"/>
                        </group>
                        <group string="Approval Audit">
                            <field name="requested_by_id"/>
                            <field name="requested_at"/>
                            <field name="approved_by_id"/>
                            <field name="approved_at"/>
                            <field name="paid_by_id"/>
                            <field name="paid_at"/>
                        </group>
                    </group>
                    <group string="Reason and Evidence">
                        <field name="reason" widget="text"/>
                        <field name="evidence" widget="text"/>
                        <field name="safaricom_verdict" widget="text"
                               invisible="case_type != 'safaricom_reversal'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mpesa_refund_case_search" model="ir.ui.view">
        <field name="name">mpesa.transaction.refund.case.search</field>
        <field name="model">mpesa.transaction.refund.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="mpesa_ref"/>
                <field name="partner_id"/>
                <field name="safaricom_case_ref"/>
                <field name="refund_payment_ref"/>
                <filter name="internal_refunds" string="Internal Refunds"
                        domain="[('case_type','=','internal_refund')]"/>
                <filter name="safaricom_cases" string="Safaricom Cases"
                        domain="[('case_type','=','safaricom_reversal')]"/>
                <filter name="open" string="Open"
                        domain="[('state','in',('draft','requested','approved','under_review','accepted','objected'))]"/>
                <filter name="closed" string="Closed"
                        domain="[('state','in',('paid','reversed','won','lost','rejected','cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by':'case_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mpesa_refund_case" model="ir.actions.act_window">
        <field name="name">Refund/Dispute Cases</field>
        <field name="res_model">mpesa.transaction.refund.case</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

</odoo>
