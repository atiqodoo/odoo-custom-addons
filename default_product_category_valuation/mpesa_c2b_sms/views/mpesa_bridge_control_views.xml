<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mpesa_bridge_control_form" model="ir.ui.view">
        <field name="name">mpesa.bridge.control.form</field>
        <field name="model">mpesa.bridge.control</field>
        <field name="arch" type="xml">
            <form string="SMS Bridge">
                <header>
                    <button name="action_start_bridge"
                            string="Start Bridge"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_restart_bridge"
                            string="Restart Bridge"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_refresh_status"
                            string="Refresh"
                            type="object"/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="status">
                        <strong>Active Engine:</strong>
                        <field name="bridge_type" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <group>
                        <field name="bridge_running" widget="boolean"/>
                        <field name="restart_locked" widget="boolean"/>
                        <field name="bridge_runner_path"/>
                    </group>
                    <group>
                        <field name="last_log_line" nolabel="1" readonly="1"/>
                        <field name="process_info" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mpesa_bridge_control" model="ir.actions.act_window">
        <field name="name">SMS Bridge</field>
        <field name="res_model">mpesa.bridge.control</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
